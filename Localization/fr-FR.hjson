# Localization file. Keep this UTF-8 (no BOM).
# The filename is just the culture code (en-US), so NO prefix is applied — the
# full "Mods.MoreAIPlayer." path is written out inside. Do NOT rename this to
# "en-US_Mods.MoreAIPlayer.hjson", or the prefix gets doubled and nothing matches.

Mods: {
	MoreAIPlayer: {
		Keybinds: {
			// CompanionWheel.DisplayName: Command Wheel
			CompanionRescue.DisplayName: Rappel d'urgence des compagnons
		}

		Fault: {
			SubsystemError: "[Compagnon fantôme] Le sous-système {0} a rencontré une erreur interne et a été ignoré pour le moment. Le jeu continue normalement."
			CompanionDisabled: "[Compagnon fantôme] Un compagnon a échoué à répétition et a été retiré en sécurité pour protéger le jeu."
			HunterDisabled: "[Compagnon fantôme] Un chasseur a échoué à répétition et a été retiré en sécurité pour protéger le jeu."
			CircuitOpened: "[Compagnon fantôme] {0} a rencontré une erreur et a été suspendu pour cette session du monde. Les autres systèmes restent actifs."
			CircuitStillOpen: "[Compagnon fantôme] Une opération risquée reste suspendue après une erreur. Rechargez le monde avant de réessayer."
			BackpackDropBlocked: "[Compagnon fantôme] Tout jeter est désactivé par défaut pour protéger votre sauvegarde. Activez-le dans la configuration seulement après avoir vérifié la compatibilité."
			// BackpackRecovered: "[Phantom Companion] A companion data error was found at {0}. The affected state was cleaned and refreshed automatically."
			// BackpackRecoveryFailed: "[Phantom Companion] A companion error at {0} could not be refreshed safely, so the affected panel was closed. Details were written to the log."
		}

		Configs: {
			MoreAIPlayerServerConfig: {
				DisplayName: Règles de jeu des compagnons fantômes

				OrdinaryCompanionsHostileToPlayers: {
					Label: "[i:BloodyMachete] Les compagnons ordinaires peuvent blesser les joueurs"
					Tooltip: Les compagnons de tout joueur peuvent blesser accidentellement n'importe quel joueur, que le PvP soit activé ou non.
				}
			}

			MoreAIPlayerClientConfig: {
				DisplayName: Paramètres client des compagnons fantômes

				Headers: {
					CompanionDiagnostics: Diagnostic des compagnons
					CompanionBalance: Équilibre et survie des compagnons
					CompanionPickup: Ramassage des objets du monde par les compagnons
					CompanionSafety: Sécurité des compagnons
				}

				EnablePhantomPlayerDebugText: {
					Label: "[i:GoldenKey] Afficher les relevés de débogage"
					Tooltip: Affiche les relevés de débogage du développement.
				}

				ShowAutomationProgress: {
					Label: "[i:Radar] Afficher la progression du joueur automatique"
					Tooltip: Affiche dans le chat chaque étape importante accomplie par le joueur automatique.
				}

				ShowCompanionHealthBars: {
					Label: "[i:LifeCrystal] Afficher une barre de vie supplémentaire"
					Tooltip: Dessine la propre barre de vie de ce mod. À activer seulement si la barre de vie par défaut ne fonctionne pas.
				}

				UseChatForCompanionReviveTimer: {
					Label: "[i:RecallPotion] Avis de mort et de réanimation dans le chat"
					Tooltip: Envoie un avis lorsqu'un compagnon meurt ou revient à la vie.
				}

				AllowRightClickOpenBackpack: {
					Label: "[i:Chest] Clic droit sur un compagnon pour ouvrir le sac"
					Tooltip: Une autre manière d'ouvrir le sac ; équivaut à cliquer directement sur son onglet.
				}

				CompanionsFightAfterOwnerDeath: {
					Label: "[i:EnchantedSword] Les compagnons combattent après votre mort"
					Tooltip: S'il est désactivé, les compagnons disparaissent immédiatement après votre mort.
				}

				CompanionsTakeDamage: {
					Label: "[i:CobaltShield] Les compagnons subissent des dégâts"
					Tooltip: Autorise les compagnons à subir des dégâts normaux, mourir et attendre de revenir à la vie.
				}

				CompanionsRescueWhenOwnerHurt: {
					Label: "[i:MagicMirror] Rappeler les compagnons quand vous êtes blessé"
					Tooltip: Téléporte immédiatement tous les compagnons vers vous lorsque vous êtes blessé.
				}

				ProtectBaseFromCompanionMining: {
					Label: "[i:PeaceCandle] Protection de la base"
					Tooltip: Lorsqu'elle est activée, les compagnons ne considèrent pas les blocs à moins de 200 cases du point d'apparition comme destructibles.
				}

				ExtraAccessorySlots: {
					Label: "[i:CelestialShell] Emplacements d'accessoires supplémentaires"
					Tooltip: Permet aux compagnons d'équiper davantage d'accessoires.
				}

				CompanionsAutoCollectWorldItems: {
					Label: "[i:TreasureMagnet] Ramasser automatiquement les objets du monde"
					Tooltip: Définit si les compagnons peuvent essayer de ramasser tout objet du monde.
				}

				CompanionsAllowBackpackWorldDrops: {
					Label: "[i:TrashCan] Autoriser le vidage rapide"
					Tooltip: Définit si le sac d'un compagnon est vidé en une action. Cela peut causer des ralentissements.
				}
			}
		}

		Items: {
			PhantomStaff: {
				// DisplayName: Phantom Staff
				/* Tooltip:
					'''
					Swing the staff: summon or recall its bound companion near you
					Right click: open the bound companion's backpack while summoned
					The first time it enters your inventory, it receives your next number and binds to you
					A staff owned by someone else is disabled; right-click it in the inventory to transfer it without resetting the companion
					With this staff in your inventory, press the Command Wheel key to command the first summoned staff
					Each staff always corresponds to one companion. The original books remain fully usable.
					''' */
			}

			DamageTestDummy: {
				DisplayName: Petit lapin
				Tooltip:
					'''
					Quel adorable petit lapin.
					Il acceptera sûrement de servir à tester les dégâts de mes armes.
					Clic gauche : placer un mannequin. Clic droit : effacer les mannequins.
					'''
			}

			DevelopmentNotice: {
				DisplayName: Note de développement des compagnons fantômes
				CombatControls: Clic gauche : manier la clé | Clic droit : lancer la clé tournoyante
				Development: Ce mod est toujours en développement actif.
				SoloCreator: Il est créé et maintenu par une seule personne.
				Updates: Je continuerai de le mettre à jour, d'améliorer les compagnons et de corriger les problèmes signalés par les joueurs.
				Compatibility: Les armes populaires des grands mods recevront progressivement une prise en charge dédiée.
				Complexity: Des armes d'apparence similaire peuvent fonctionner très différemment en interne ; certaines demandent donc beaucoup plus de temps pour être prises en charge de manière fiable. Merci de votre patience.
				BetaControlsFirstLine: Cette bêta propose actuellement deux méthodes de contrôle : six livres, ou le Bâton fantôme avec sa roue de commandes.
				BetaControlsSecondLine: Choisissez celle qui vous convient ; les commandes seront simplifiées et réorganisées plus tard.
				ConfigSuggestion: Pensez à consulter les options de configuration.
				Tooltip: Informations sur le développement et les options de configuration.
			}

			CompanionDevelopmentBook: {
				DisplayName: Livre de developpement
				Tooltip:
					'''
					Clic gauche : lancer une serie de tests de debogage.
					Les tests se lancent automatiquement.
					-- Objet de developpeur --
					'''
				Started: Test de developpement lance.
				Stopped: Test de developpement arrete et nettoye.
				Completed: Test de developpement termine et nettoye.
				Failed: Test de developpement interrompu ; le compagnon temporaire a ete nettoye.
				StepSummon: "[DEV] Compagnon temporaire invoque."
				StepAttack: "[DEV] Mode attaque active."
				StepEscort: "[DEV] Mode escorte active."
				StepGarrison: "[DEV] Mode garnison active."
				StepCatch: "[DEV] Mode capture active."
				StepFishing: "[DEV] Mode peche active."
				StepMining: "[DEV] Mode minage active."
				StepWaypoint: "[DEV] Point de passage donne."
				StepBackpack: "[DEV] Objet ajoute au sac a dos."
			}

			CompanionDebugger: {
				DisplayName: Grimoire de débogage
				Tooltip:
					'''
					Clic gauche : invoque un compagnon à la position du curseur. Réutilisez-le pour invoquer le compagnon sauvegardé suivant.
					Les compagnons sont liés au joueur, non au monde, et chacun consomme un emplacement de serviteur.
					Clic droit : ouvre le gestionnaire de compagnons. Vous pouvez y renvoyer certains compagnons ou tous à la fois.
					Cliquez sur le panneau des compagnons en haut de l'écran : ouvre son équipement et son sac.
					Vous pouvez aussi activer « Clic droit sur un compagnon pour ouvrir son sac » dans la configuration afin de l'ouvrir directement par clic droit.
					Armes : toutes les armes sont acceptées, y compris celles d'invocation. La barre d'armes est vérifiée de gauche à droite ; les armes à distance utilisent des munitions de base si elles n'en ont plus.

					Notes techniques :
					Les compagnons sont de véritables entités joueur inscrites dans des emplacements de joueur : animations d'armes, effets d'équipement et physique de déplacement passent par le jeu de base.
					Ils vous suivent grâce au pathfinding, sautent, volent et traversent les plateformes ; ils ne se téléportent qu'après être restés longtemps trop loin.
					Subissez un coup ou double-cliquez rapidement à droite pour les rappeler à vos côtés ; ils reviennent aussi automatiquement s'ils sont coincés.
					Ce système étant assez inhabituel, seul le mode solo est pris en charge pour l'instant.
					Certaines armes de mods complexes ou avancées peuvent être incompatibles. Il n'existe pas de liste complète : testez-les progressivement.
					'''
				RescueShortcut: Double-cliquez sur [{0}] pour appeler rapidement tous les compagnons auprès de vous.
				RescueDefaultKey: Bouton droit de la souris
			}

			CompanionCommandBook: {
				DisplayName: Grimoire d'ordres
				Tooltip:
					'''
					Maintenir le clic droit : alterne entre les trois modes de combat Attaque / Défense / Garnison. Le mode choisi s'affiche au-dessus de votre tête.
					· Attaque : suit librement et combat, mine et ramasse activement.
					· Défense : reste près de vous comme garde du corps et n'attaque pas les ennemis de lui-même.
					· Garnison : marque l'endroit à l'activation, y combat et y retourne s'il est repoussé.
					Trois modes non-combat existent aussi : Pêche / Capture / Minage.
					Clic gauche : place un point de passage sous le curseur. Les compagnons s'y rendent et tiennent la position ; cliquez de nouveau près du repère pour l'annuler.
					Un point de passage dure au plus 5 s et disparaît s'il n'est pas atteint. Une fois sur place, le compagnon y reste jusqu'à un nouvel ordre ou un appel de secours.
					Le comportement d'attaque est identique dans tous les modes ; seul le déplacement change.

					Notes techniques :
					De nombreuses formes tactiques seront ajoutées avec le temps pour répondre à différents besoins.
					Même maintenant, le pathfinding peut échouer dans un terrain complexe.
					Essayez librement. Si quelque chose ne va pas, rechargez puis réessayez ; pour un problème grave, signalez-le dans les commentaires.
					Il y a certainement beaucoup de problèmes qu'une seule personne ne peut pas découvrir.
					'''
			}

			CompanionHunterBook: {
				DisplayName: Grimoire des chasseurs
				Tooltip:
					'''
					Clic gauche : lance ou abandonne l'Épreuve des chasseurs choisie. Ils se rassemblent d'abord au loin.
					Clic droit : choisissez 1 à 3 chasseurs et une règle.
					· Survie : tenez 180 secondes face à des chasseurs qui reviennent après leur défaite.
					· Élimination : battez le nombre requis de chasseurs.
					· Percée : atteignez une sortie lointaine en 150 secondes ; les chasseurs interceptent votre route.
					Disponible après un boss pré-Hardmode jusqu'au Mur de chair, puis au début du Hardmode jusqu'à Plantera.
					L'équipement dépend de la phase du monde, jamais de votre défense. Plus ils sont nombreux, plus chacun est faible.
					'''
			}

			CompanionBuilderBook: {
				DisplayName: Grimoire de l'architecte
				Tooltip:
					'''
					Hold right click: open the tactic wheel. Left click: switch the selected tactic on or off.
					· Smart Build: while you place the same block along a line, companions continue that block in the same direction from their own or your inventory.
					· Defensive Build: when an enemy is near, companions raise a short blocking pillar between you and the nearest threat.
					· Battle Platform: while you stand on a platform whose facing edge breaks off ahead, companions extend flat platforms across the gap — about six tiles ahead, so keep walking to keep bridging. They will not drop off the bridge, and return to your side if knocked off.
					Builders take non-favourited materials from active companion backpacks first, then your inventory. Work pauses safely if supplies run out.
					Companions never mine or replace blocks. Combat, rescue calls, waypoints and specialist modes always take priority. Single-player only.
					'''
			}

			CompanionAutomationBook: {
				DisplayName: Grimoire automatique
				Tooltip:
					'''
					[Pour le divertissement uniquement ; cette fonction est encore en phase de test]
					Clic gauche : invoque le compagnon automatique ; un autre clic gauche le rappelle et mémorise position, inventaire et progression
					Clic droit : déplace la caméra sur le compagnon automatique ; recliquez pour revenir à vous
					Il tentera d'explorer, récolter, construire, combattre et progresser de manière autonome ; une fois terminé, sa sauvegarde sera conservée et il s'arrêtera sans rejoindre le système de suivi des compagnons ordinaires
					Il peut encore se bloquer, se tromper ou rencontrer d'autres bugs. Sauvegardez le monde d'abord. Solo uniquement.
					'''
			}

			PlayerScaleBook: {
				DisplayName: Grimoire de matrice cristalline
				Tooltip: "[Pour le plaisir] Clic droit : ouvrir la matrice et choisir une taille. Clic gauche : appliquer la taille ; cliquer encore pour revenir à 1×."
			}
		}


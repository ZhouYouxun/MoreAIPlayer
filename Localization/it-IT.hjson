# Localization file. Keep this UTF-8 (no BOM).
# The filename is just the culture code (en-US), so NO prefix is applied — the
# full "Mods.MoreAIPlayer." path is written out inside. Do NOT rename this to
# "en-US_Mods.MoreAIPlayer.hjson", or the prefix gets doubled and nothing matches.

Mods: {
	MoreAIPlayer: {
		Configs: {
			MoreAIPlayerClientConfig: {
				DisplayName: Impostazioni client dei compagni fantasma

				Headers: {
					CompanionDiagnostics: Diagnostica dei compagni
					CompanionBalance: Equilibrio e sopravvivenza dei compagni
					CompanionPickup: Raccolta degli oggetti del mondo dei compagni
				}

				EnablePhantomPlayerDebugText: {
					Label: "[i:GoldenKey] Abilita testo di debug dei giocatori fantasma"
					Tooltip: Mostra dati di sviluppo in tempo reale sopra i compagni fantasma. Disabilitato per impostazione predefinita.
				}

				CompanionsFightAfterOwnerDeath: {
					Label: I compagni combattono dopo la morte del giocatore
					Tooltip: Attivo per impostazione predefinita. Se muori durante un boss, i compagni legati restano e continuano a combattere. Disattivalo per dissolverli subito alla tua morte.
				}

				CompanionsTakeDamage: {
					Label: I compagni subiscono danni
					Tooltip: Attivo per impostazione predefinita. I compagni subiscono danni, possono morire e tornano dopo il normale tempo di attesa. Disattivalo per renderli immuni a tutti i danni.
				}

				CompanionsAutoCollectWorldItems: {
					Label: I compagni raccolgono automaticamente gli oggetti del mondo
					Tooltip: Disattivato per impostazione predefinita. Quando è disattivato, i compagni non cercano, prenotano, raggiungono né raccolgono oggetti del mondo. Attivalo solo dopo aver verificato la compatibilità con il salvataggio e le altre mod.
				}
			}
		}

		Items: {
			DamageTestDummy: {
				DisplayName: Coniglietto
				Tooltip:
					'''
					Che adorabile coniglietto.
					Sicuramente accetterà di essere il mio strumento per testare i danni delle armi.
					Clic sinistro: piazza un manichino. Clic destro: rimuovi i manichini.
					'''
			}

			DevelopmentNotice: {
				DisplayName: Nota di sviluppo dei compagni fantasma
				Development: Questa mod è ancora in sviluppo attivo.
				SoloCreator: È realizzata e mantenuta da una sola persona.
				Updates: Continuerò ad aggiornarla, a migliorare i compagni e a correggere i problemi segnalati dai giocatori.
				Compatibility: Le armi popolari delle grandi mod riceveranno gradualmente compatibilità dedicata.
				Complexity: Armi dall'aspetto simile possono funzionare in modo molto diverso internamente; alcune richiedono quindi molto più tempo per essere supportate in sicurezza. Grazie per la pazienza.
				ConfigSuggestion: Dai un'occhiata alle opzioni di configurazione.
				Tooltip: Informazioni sullo sviluppo e sulle opzioni di configurazione.
			}

			CompanionDebugger: {
				DisplayName: Libro di debug
				Tooltip:
					'''
					Clic sinistro: evoca un compagno alla posizione del cursore. Usalo di nuovo per evocare il successivo compagno salvato.
					I compagni sono legati al giocatore, non al mondo, e ciascuno consuma uno slot servitore.
					Clic destro: apre il gestore dei compagni. Da lì puoi congedarne alcuni o tutti insieme.
					Clic destro su un compagno: apre il suo equipaggiamento e lo zaino. Non devi tenere alcun oggetto in mano.
					Armi: è consentita qualsiasi arma, comprese quelle di evocazione. La barra delle armi viene controllata da sinistra a destra; le armi a distanza usano munizioni base quando finiscono le munizioni.

					Note tecniche:
					I compagni sono vere entità giocatore registrate negli slot giocatore: animazioni, effetti dell'equipaggiamento e fisica del movimento sono gestiti dal gioco base.
					Ti seguono con il pathfinding, saltando, volando e attraversando le piattaforme; si teletrasportano solo dopo essere rimasti molto lontani per un po'.
					Subisci un colpo o fai rapidamente doppio clic destro per richiamarli a proteggerti; tornano automaticamente anche se si bloccano.
					Poiché questo sistema è piuttosto insolito, al momento supporta solo il giocatore singolo.
					Alcune armi complesse o avanzate di altri mod potrebbero non essere compatibili. Non esiste un elenco completo: provale gradualmente.
					'''
			}

			CompanionCommandBook: {
				DisplayName: Libro dei comandi
				Tooltip:
					'''
					Tieni premuto il clic destro: passa tra le tre modalità di combattimento Assalto / Difesa / Guarnigione. La modalità scelta appare sopra la tua testa.
					· Assalto: segue liberamente e attacca, scava e raccoglie attivamente.
					· Difesa: resta vicino come guardia del corpo e non attacca i nemici di sua iniziativa.
					· Guarnigione: segna il luogo all'attivazione, combatte lì e vi ritorna se viene respinto.
					Esistono anche tre modalità non di combattimento: Pesca / Cattura / Estrazione.
					Clic sinistro: colloca un punto di passaggio al cursore. I compagni andranno lì e terranno la posizione; fai di nuovo clic vicino al segnale per annullarlo.
					Un punto di passaggio dura al massimo 5 s e scompare se non viene raggiunto. Una volta arrivato, il compagno resta lì fino a un nuovo ordine o a una chiamata di soccorso.
					L'attacco è identico in tutte le modalità; cambia solo il movimento.

					Note tecniche:
					Nel tempo verranno aggiunte più forme tattiche possibile, per adattarsi a esigenze diverse.
					Anche ora, il pathfinding può fallire in terreni complessi.
					Sperimenta liberamente. Se qualcosa non va, ricarica e riprova; per problemi gravi, segnalali nei commenti.
					Ci sono sicuramente molti problemi che una sola persona non può scoprire.
					'''
			}

			CompanionHunterBook: {
				DisplayName: Libro dei cacciatori
				Tooltip:
					'''
					Nota: questo oggetto è ancora in prova e potrebbe avere problemi.
					Clic sinistro: attiva o disattiva la modalità Caccia. Cacciatori ostili seguiranno le tue tracce.
					Clic destro: apre le impostazioni Caccia e permette di scegliere da 1 a 3 cacciatori.
					L'equipaggiamento dei cacciatori scala con il progresso del mondo e la tua difesa. La modalità Caccia attiva il PvP finché è attiva.
					I cacciatori ti inseguono per 2 minuti, riposano 45 secondi e poi riprendono la caccia.
					I cacciatori sconfitti tornano dopo 60 secondi con nuovo equipaggiamento.
					'''
			}

			CompanionBuilderBook: {
				DisplayName: Tomo dell'Architetto
				Tooltip:
					'''
					Clic destro: alterna cinque progetti. Clic sinistro: esegue quello scelto. Giù + clic sinistro: annulla tutti i lavori.
					· Assistenza intelligente: attiva l'aiuto continuo. I compagni imparano i blocchi e i muri posati e prolungano schemi brevi e chiari.
					· Ponte: costruisce un ponte orizzontale di piattaforme lungo fino a 160 caselle verso il cursore.
					· Rifugio: costruisce un telaio di 11 × 7 con ingresso di tre caselle e aggiunge muri e luci se disponibili.
					· Arena: costruisce tre file di 61 piattaforme distanti dieci caselle, usando l'illuminazione disponibile.
					· Pozzo di corde: posa fino a 120 caselle di corda verticale e luci nei punti con sostegno.
					Usano prima i materiali non preferiti negli zaini dei compagni attivi, poi il tuo inventario. Se finiscono, il lavoro si mette in pausa.
					Non scavano né sostituiscono mai blocchi. Combattimento, soccorso, segnali e modalità specializzate hanno sempre la priorità. Solo giocatore singolo.
					'''
			}

			PlayerScaleBook: {
				DisplayName: Tomo della Matrice di Cristallo
				Tooltip: "[Solo per divertimento] Clic destro: apri la matrice e scegli una scala. Clic sinistro: applicala; clicca di nuovo per tornare a 1×."
			}
		}

		VanillaItemHints: {
			LifeCrystal: "[Compagno fantasma] Non serve usarlo sul compagno: la sua vita massima copia direttamente quella del giocatore."
			ManaCrystal: "[Compagno fantasma] Non serve usarlo sul compagno: il suo mana massimo copia direttamente quello del giocatore."
		}


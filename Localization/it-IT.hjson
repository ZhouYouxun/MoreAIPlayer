# Localization file. Keep this UTF-8 (no BOM).
# The filename is just the culture code (en-US), so NO prefix is applied — the
# full "Mods.MoreAIPlayer." path is written out inside. Do NOT rename this to
# "en-US_Mods.MoreAIPlayer.hjson", or the prefix gets doubled and nothing matches.

Mods: {
	MoreAIPlayer: {
		Keybinds: {
			// CompanionWheel.DisplayName: Command Wheel
			CompanionRescue.DisplayName: Richiamo d'emergenza dei compagni
		}

		Fault: {
			SubsystemError: "[Compagno fantasma] Il sottosistema {0} ha avuto un errore interno ed è stato saltato per ora. Il gioco continua normalmente."
			CompanionDisabled: "[Compagno fantasma] Un compagno ha continuato a fallire ed è stato rimosso in sicurezza per proteggere il gioco."
			HunterDisabled: "[Compagno fantasma] Un cacciatore ha continuato a fallire ed è stato rimosso in sicurezza per proteggere il gioco."
			CircuitOpened: "[Compagno fantasma] {0} ha avuto un errore ed è stato sospeso per questa sessione del mondo. Gli altri sistemi restano attivi."
			CircuitStillOpen: "[Compagno fantasma] Un'operazione rischiosa resta sospesa dopo un errore. Ricarica il mondo prima di riprovare."
			BackpackDropBlocked: "[Compagno fantasma] Svuota zaino è disabilitato per impostazione predefinita per proteggere il salvataggio. Abilitalo nelle impostazioni solo dopo aver verificato la compatibilità."
			// BackpackRecovered: "[Phantom Companion] A companion data error was found at {0}. The affected state was cleaned and refreshed automatically."
			// BackpackRecoveryFailed: "[Phantom Companion] A companion error at {0} could not be refreshed safely, so the affected panel was closed. Details were written to the log."
		}

		Configs: {
			MoreAIPlayerServerConfig: {
				DisplayName: Regole di gioco dei compagni fantasma

				OrdinaryCompanionsHostileToPlayers: {
					Label: "[i:BloodyMachete] I compagni normali possono ferire i giocatori"
					Tooltip: Disattivato per impostazione predefinita e destinato solo a divertimento e test. Influisce soltanto sui compagni normali evocati dal libro di debug. Restano alleati tra loro e prendono di mira solo PNG ostili. I giocatori possono ferirli e le loro armi o i loro proiettili possono ferire i giocatori al contatto. Cacciatori e compagni automatici presenti o passati sono esclusi.
				}
			}

			MoreAIPlayerClientConfig: {
				DisplayName: Impostazioni client dei compagni fantasma

				Headers: {
					CompanionDiagnostics: Diagnostica dei compagni
					CompanionBalance: Equilibrio e sopravvivenza dei compagni
					CompanionPickup: Raccolta degli oggetti del mondo dei compagni
					CompanionSafety: Sicurezza dei compagni
				}

				EnablePhantomPlayerDebugText: {
					Label: "[i:GoldenKey] Abilita testo di debug dei giocatori fantasma"
					Tooltip: Mostra dati di sviluppo in tempo reale sopra i compagni fantasma. Disabilitato per impostazione predefinita.
				}

				ShowCompanionHealthBars: {
					// Label: "[i:LifeCrystal] Show companion health bars"
					// Tooltip: Disabled by default. Companions occupy real player slots, so the game already draws a health bar over them. Enable to also show the mod's own bar below each companion.
				}

				UseChatForCompanionReviveTimer: {
					Label: "[i:RecallPotion] Mostra la resurrezione in chat"
					Tooltip: Disattivato per impostazione predefinita. Sostituisce il conto alla rovescia con un messaggio alla morte e uno alla resurrezione.
				}

				AllowRightClickOpenBackpack: {
					// Label: "[i:Chest] Right-click a companion to open its backpack"
					// Tooltip: Disabled by default. When off, right-clicking a companion does nothing and the backpack opens only through the matrix panel at the top of the screen. Enable to open it by right-clicking the companion.
				}

				CompanionsFightAfterOwnerDeath: {
					Label: "[i:EnchantedSword] I compagni combattono dopo la morte del giocatore"
					Tooltip: Attivo per impostazione predefinita. Se muori durante un boss, i compagni legati restano e continuano a combattere. Disattivalo per dissolverli subito alla tua morte.
				}

				CompanionsTakeDamage: {
					Label: "[i:CobaltShield] I compagni subiscono danni"
					Tooltip: Disattivato per impostazione predefinita. Attivalo perché i compagni subiscano danni normali, possano morire e tornino dopo il normale tempo di attesa. Se disattivato, sono immuni a tutti i danni.
				}

				CompanionsRescueWhenOwnerHurt: {
					Label: "[i:MagicMirror] Richiama i compagni quando subisci danni"
					Tooltip: Disattivato per impostazione predefinita. I compagni si teletrasportano in posizioni sicure e separate vicino a te.
				}

				ExtraAccessorySlots: {
					Label: "[i:CelestialShell] Slot accessori aggiuntivi del compagno"
					Tooltip: Cursore client da 0 a 7. Riducendolo, gli oggetti restano salvati ma i loro effetti si disattivano.
				}

				CompanionsAutoCollectWorldItems: {
					Label: "[i:TreasureMagnet] I compagni raccolgono automaticamente gli oggetti del mondo"
					Tooltip: Disattivato per impostazione predefinita. Quando è disattivato, i compagni non cercano, prenotano, raggiungono né raccolgono oggetti del mondo. Attivalo solo dopo aver verificato la compatibilità con il salvataggio e le altre mod.
				}

				CompanionsAllowBackpackWorldDrops: {
					Label: "[i:TrashCan] Permetti ai compagni di gettare nel mondo gli oggetti dello zaino"
					Tooltip: Disattivato per impostazione predefinita. Svuota zaino crea oggetti del mondo e può richiamare hook di altre mod. Attivalo solo dopo aver confermato che il salvataggio è stabile.
				}
			}
		}

		Items: {
			PhantomStaff: {
				// DisplayName: Phantom Staff
				/* Tooltip:
					'''
					Swing the staff: summon or recall its bound companion near you
					Right click: open the bound companion's backpack while summoned
					The first time it enters your inventory, it receives your next number and binds to you
					A staff owned by someone else is disabled; right-click it in the inventory to transfer it without resetting the companion
					With this staff in your inventory, press the Command Wheel key to command the first summoned staff
					Each staff always corresponds to one companion. The original books remain fully usable.
					''' */
			}

			DamageTestDummy: {
				DisplayName: Coniglietto
				Tooltip:
					'''
					Che adorabile coniglietto.
					Sicuramente accetterà di essere il mio strumento per testare i danni delle armi.
					Clic sinistro: piazza un manichino. Clic destro: rimuovi i manichini.
					'''
			}

			DevelopmentNotice: {
				DisplayName: Nota di sviluppo dei compagni fantasma
				Development: Questa mod è ancora in sviluppo attivo.
				SoloCreator: È realizzata e mantenuta da una sola persona.
				Updates: Continuerò ad aggiornarla, a migliorare i compagni e a correggere i problemi segnalati dai giocatori.
				Compatibility: Le armi popolari delle grandi mod riceveranno gradualmente compatibilità dedicata.
				Complexity: Armi dall'aspetto simile possono funzionare in modo molto diverso internamente; alcune richiedono quindi molto più tempo per essere supportate in sicurezza. Grazie per la pazienza.
				BetaControlsFirstLine: Questa beta offre attualmente due metodi di controllo: sei libri oppure il Bastone Fantasma con la sua ruota dei comandi.
				BetaControlsSecondLine: Scegli quello più adatto; i comandi verranno semplificati e riordinati in seguito.
				ConfigSuggestion: Dai un'occhiata alle opzioni di configurazione.
				Tooltip: Informazioni sullo sviluppo e sulle opzioni di configurazione.
			}

			CompanionDevelopmentBook: {
				DisplayName: Libro di sviluppo
				Tooltip:
					'''
					Clic sinistro: avvia una serie di test di debug.
					I test verranno eseguiti automaticamente.
					-- Oggetto per sviluppatori --
					'''
				Started: Test di sviluppo avviato.
				Stopped: Test di sviluppo interrotto e ripulito.
				Completed: Test di sviluppo completato e ripulito.
				Failed: Test di sviluppo interrotto; il compagno temporaneo e stato ripulito.
				StepSummon: "[DEV] Compagno temporaneo evocato."
				StepAttack: "[DEV] Passato alla modalita attacco."
				StepEscort: "[DEV] Passato alla modalita scorta."
				StepGarrison: "[DEV] Passato alla modalita presidio."
				StepCatch: "[DEV] Passato alla modalita cattura."
				StepFishing: "[DEV] Passato alla modalita pesca."
				StepMining: "[DEV] Passato alla modalita estrazione."
				StepWaypoint: "[DEV] Punto di passaggio assegnato."
				StepBackpack: "[DEV] Oggetto inserito nello zaino."
			}

			CompanionDebugger: {
				DisplayName: Libro di debug
				Tooltip:
					'''
					Clic sinistro: evoca un compagno alla posizione del cursore. Usalo di nuovo per evocare il successivo compagno salvato.
					I compagni sono legati al giocatore, non al mondo, e ciascuno consuma uno slot servitore.
					Clic destro: apre il gestore dei compagni. Da lì puoi congedarne alcuni o tutti insieme.
					Clicca sul pannello dei compagni in alto sullo schermo: apre equipaggiamento e zaino.
					Puoi anche attivare nelle Configurazioni “Clic destro su un compagno per aprire lo zaino” per aprirlo direttamente con il clic destro sul compagno.
					Armi: è consentita qualsiasi arma, comprese quelle di evocazione. La barra delle armi viene controllata da sinistra a destra; le armi a distanza usano munizioni base quando finiscono le munizioni.

					Note tecniche:
					I compagni sono vere entità giocatore registrate negli slot giocatore: animazioni, effetti dell'equipaggiamento e fisica del movimento sono gestiti dal gioco base.
					Ti seguono con il pathfinding, saltando, volando e attraversando le piattaforme; si teletrasportano solo dopo essere rimasti molto lontani per un po'.
					Subisci un colpo o fai rapidamente doppio clic destro per richiamarli a proteggerti; tornano automaticamente anche se si bloccano.
					Poiché questo sistema è piuttosto insolito, al momento supporta solo il giocatore singolo.
					Alcune armi complesse o avanzate di altri mod potrebbero non essere compatibili. Non esiste un elenco completo: provale gradualmente.
					'''
				RescueShortcut: Fai doppio clic su [{0}] per richiamare rapidamente tutti i compagni al tuo fianco.
				RescueDefaultKey: Pulsante destro del mouse
			}

			CompanionCommandBook: {
				DisplayName: Libro dei comandi
				Tooltip:
					'''
					Tieni premuto il clic destro: passa tra le tre modalità di combattimento Assalto / Difesa / Guarnigione. La modalità scelta appare sopra la tua testa.
					· Assalto: segue liberamente e attacca, scava e raccoglie attivamente.
					· Difesa: resta vicino come guardia del corpo e non attacca i nemici di sua iniziativa.
					· Guarnigione: segna il luogo all'attivazione, combatte lì e vi ritorna se viene respinto.
					Esistono anche tre modalità non di combattimento: Pesca / Cattura / Estrazione.
					Clic sinistro: colloca un punto di passaggio al cursore. I compagni andranno lì e terranno la posizione; fai di nuovo clic vicino al segnale per annullarlo.
					Un punto di passaggio dura al massimo 5 s e scompare se non viene raggiunto. Una volta arrivato, il compagno resta lì fino a un nuovo ordine o a una chiamata di soccorso.
					L'attacco è identico in tutte le modalità; cambia solo il movimento.

					Note tecniche:
					Nel tempo verranno aggiunte più forme tattiche possibile, per adattarsi a esigenze diverse.
					Anche ora, il pathfinding può fallire in terreni complessi.
					Sperimenta liberamente. Se qualcosa non va, ricarica e riprova; per problemi gravi, segnalali nei commenti.
					Ci sono sicuramente molti problemi che una sola persona non può scoprire.
					'''
			}

			CompanionHunterBook: {
				DisplayName: Libro dei cacciatori
				Tooltip:
					'''
					Clic sinistro: avvia o abbandona la Prova dei cacciatori scelta. Prima si radunano in lontananza.
					Clic destro: scegli da 1 a 3 cacciatori e una regola.
					· Sopravvivenza: resisti 180 secondi contro cacciatori che tornano dopo la sconfitta.
					· Eliminazione: sconfiggi il numero richiesto di cacciatori.
					· Sfondamento: raggiungi un'uscita lontana entro 150 secondi; i cacciatori intercettano il percorso.
					Disponibile dopo un boss pre-Hardmode fino al Muro di Carne e nel primo Hardmode fino a Plantera.
					L'equipaggiamento dipende dalla fase del mondo, mai dalla tua difesa. Più cacciatori significa individui più deboli.
					'''
			}

			CompanionBuilderBook: {
				DisplayName: Tomo dell'Architetto
				Tooltip:
					'''
					Hold right click: open the tactic wheel. Left click: switch the selected tactic on or off.
					· Smart Build: while you place the same block along a line, companions continue that block in the same direction from their own or your inventory.
					· Defensive Build: when an enemy is near, companions raise a short blocking pillar between you and the nearest threat.
					· Battle Platform: while you stand on a platform whose facing edge breaks off ahead, companions extend flat platforms across the gap — about six tiles ahead, so keep walking to keep bridging. They will not drop off the bridge, and return to your side if knocked off.
					Builders take non-favourited materials from active companion backpacks first, then your inventory. Work pauses safely if supplies run out.
					Companions never mine or replace blocks. Combat, rescue calls, waypoints and specialist modes always take priority. Single-player only.
					'''
			}

			CompanionAutomationBook: {
				DisplayName: Tomo automatico
				Tooltip:
					'''
					[Solo per divertimento; questa funzione è ancora in fase di test]
					Clic sinistro: evoca il tuo unico compagno automatico (quello esistente non viene mai azzerato o sostituito)
					Clic destro: apre il suo zaino
					Proverà autonomamente a esplorare, raccogliere, costruire, combattere e avanzare nel mondo; al termine diventerà un normale compagno fantasma
					Può ancora bloccarsi, sbagliare o incontrare altri bug. Esegui prima un backup del mondo. Solo giocatore singolo.
					'''
			}

			PlayerScaleBook: {
				DisplayName: Tomo della Matrice di Cristallo
				Tooltip: "[Solo per divertimento] Clic destro: apri la matrice e scegli una scala. Clic sinistro: applicala; clicca di nuovo per tornare a 1×."
			}
		}


		CompanionCommand: {
			// StaffUnbound: This Phantom Staff has not chosen a companion yet. Left click once to bind it.
			// StaffNotSummoned: Summon this staff's companion before opening its backpack.
			// StaffUnboundTooltip: Unbound - left click to choose or create a companion

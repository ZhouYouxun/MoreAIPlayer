# Localization file. Keep this UTF-8 (no BOM).
# The filename is just the culture code (en-US), so NO prefix is applied — the
# full "Mods.MoreAIPlayer." path is written out inside. Do NOT rename this to
# "en-US_Mods.MoreAIPlayer.hjson", or the prefix gets doubled and nothing matches.

Mods: {
	MoreAIPlayer: {
		Fault: {
			SubsystemError: "[Phantom-Begleiter] Das Teilsystem {0} hatte einen internen Fehler und wurde vorerst übersprungen. Das Spiel läuft weiter."
			CompanionDisabled: "[Phantom-Begleiter] Ein Begleiter verursachte wiederholt Fehler und wurde zum Schutz des Spiels sicher entfernt."
			HunterDisabled: "[Phantom-Begleiter] Ein Jäger verursachte wiederholt Fehler und wurde zum Schutz des Spiels sicher entfernt."
			CircuitOpened: "[Phantom-Begleiter] {0} hatte einen Fehler und wurde für diese Weltsitzung pausiert. Andere Begleiterfunktionen bleiben aktiv."
			CircuitStillOpen: "[Phantom-Begleiter] Eine riskante Begleiteraktion bleibt nach einem Fehler pausiert. Lade die Welt neu, bevor du es erneut versuchst."
			BackpackDropBlocked: "[Phantom-Begleiter] Rucksack leeren ist zum Schutz des Spielstands standardmäßig deaktiviert. Aktiviere es erst nach einer Kompatibilitätsprüfung in den Einstellungen."
		}

		Configs: {
			MoreAIPlayerServerConfig: {
				DisplayName: Phantomgefährten-Spielregeln

				OrdinaryCompanionsHostileToPlayers: {
					Label: "[i:BloodyMachete] Normale Gefährten können Spieler verletzen"
					Tooltip: Standardmäßig deaktiviert und nur für Unterhaltung und Tests gedacht. Betrifft nur normale Gefährten aus dem Debug-Buch. Sie bleiben untereinander verbündet und greifen weiterhin nur feindliche NPCs an. Spieler können sie verletzen und ihre Waffen oder Projektile können Spieler bei Berührung verletzen. Jäger sowie aktuelle oder ehemalige Automatikgefährten sind ausgeschlossen.
				}
			}

			MoreAIPlayerClientConfig: {
				DisplayName: Phantom-Begleiter Client-Einstellungen

				Headers: {
					CompanionDiagnostics: Begleiter-Diagnose
					CompanionBalance: Begleiter-Balance und Überleben
					CompanionPickup: Weltgegenstände der Begleiter
					CompanionSafety: Begleiter-Sicherheit
				}

				EnablePhantomPlayerDebugText: {
					Label: "[i:GoldenKey] Debug-Text für Phantomspieler aktivieren"
					Tooltip: Zeigt über Phantom-Begleitern eine Live-Entwicklungsanzeige. Standardmäßig deaktiviert.
				}

				ShowCompanionHealthBars: {
					// Label: "[i:LifeCrystal] Show companion health bars"
					// Tooltip: Disabled by default. Companions occupy real player slots, so the game already draws a health bar over them. Enable to also show the mod's own bar below each companion.
				}

				AllowRightClickOpenBackpack: {
					// Label: "[i:Chest] Right-click a companion to open its backpack"
					// Tooltip: Disabled by default. When off, right-clicking a companion does nothing and the backpack opens only through the matrix panel at the top of the screen. Enable to open it by right-clicking the companion.
				}

				CompanionsFightAfterOwnerDeath: {
					Label: "[i:EnchantedSword] Begleiter kämpfen nach dem Tod weiter"
					Tooltip: Standardmäßig aktiviert. Bei deinem Tod im Bosskampf bleiben gebundene Begleiter und kämpfen weiter. Deaktivieren, um sie beim Tod sofort aufzulösen.
				}

				CompanionsTakeDamage: {
					Label: "[i:CobaltShield] Begleiter erleiden Schaden"
					Tooltip: Standardmäßig deaktiviert. Aktivieren, damit Begleiter normalen Schaden erleiden, sterben und nach ihrer normalen Wartezeit wiederbelebt werden. Deaktiviert sind sie gegen allen Schaden immun.
				}

				CompanionsRescueWhenOwnerHurt: {
					Label: "[i:MagicMirror] Gefährten bei Schaden herbeirufen"
					Tooltip: Standardmäßig deaktiviert. Bei Schaden werden Gefährten auf getrennte, sichere Plätze in deiner Nähe teleportiert.
				}

				ExtraAccessorySlots: {
					Label: "[i:CelestialShell] Zusätzliche Begleiter-Zubehörplätze"
					Tooltip: Client-Regler von 0 bis 7. Gespeicherte Gegenstände bleiben erhalten, wenn der Wert gesenkt wird, sind dann aber inaktiv.
				}

				CompanionsAutoCollectWorldItems: {
					Label: "[i:TreasureMagnet] Begleiter sammeln Weltgegenstände automatisch ein"
					Tooltip: Standardmäßig deaktiviert. Ist die Option aus, scannen, reservieren, verfolgen und sammeln Begleiter keine Weltgegenstände. Erst nach einer Kompatibilitätsprüfung mit Spielstand und Mods aktivieren.
				}

				CompanionsAllowBackpackWorldDrops: {
					Label: "[i:TrashCan] Begleiter dürfen Rucksackgegenstände in die Welt werfen"
					Tooltip: Standardmäßig deaktiviert. Rucksack leeren erzeugt Weltgegenstände und kann Item-Hooks anderer Mods auslösen. Erst aktivieren, wenn dein Spielstand stabil ist.
				}
			}
		}

		Keybinds.CompanionRescue.DisplayName: Begleiter-Notruf

		Items: {
			DamageTestDummy: {
				DisplayName: Kleines Häschen
				Tooltip:
					'''
					So ein niedliches kleines Häschen.
					Sicher stimmt es zu, mein Waffenschaden-Testwerkzeug zu sein.
					Linksklick: Puppe platzieren. Rechtsklick: Puppen entfernen.
					'''
			}

			DevelopmentNotice: {
				DisplayName: Entwicklungsnotiz zu Phantom-Begleitern
				Development: Dieser Mod befindet sich weiterhin in aktiver Entwicklung.
				SoloCreator: Er wird von einer Person erstellt und gepflegt.
				Updates: Ich werde ihn weiter aktualisieren, die Begleiter verbessern und von Spielern gemeldete Probleme beheben.
				Compatibility: Beliebte Waffen großer Mods erhalten nach und nach individuelle Kompatibilitätsarbeit.
				Complexity: Ähnlich aussehende Waffen können intern sehr unterschiedlich funktionieren; einige benötigen daher deutlich mehr Zeit, um sicher unterstützt zu werden. Danke für eure Geduld.
				ConfigSuggestion: Schau auch in die Konfigurationsoptionen.
				Tooltip: Hinweis zum Entwicklungsstand und zu Konfigurationsoptionen.
			}

			CompanionDevelopmentBook: {
				DisplayName: Entwicklungsbuch
				Tooltip:
					'''
					Linksklick startet eine Reihe von Debug-Tests.
					Die Tests laufen automatisch ab.
					-- Entwicklergegenstand --
					'''
				Started: Entwicklungstest gestartet.
				Stopped: Entwicklungstest beendet und bereinigt.
				Completed: Entwicklungstest abgeschlossen und bereinigt.
				Failed: Entwicklungstest abgebrochen; der temporaere Begleiter wurde bereinigt.
				StepSummon: "[DEV] Temporaerer Begleiter beschworen."
				StepAttack: "[DEV] Angriffsmodus aktiviert."
				StepEscort: "[DEV] Eskortmodus aktiviert."
				StepGarrison: "[DEV] Wachmodus aktiviert."
				StepCatch: "[DEV] Fangmodus aktiviert."
				StepFishing: "[DEV] Angelmodus aktiviert."
				StepMining: "[DEV] Bergbaumodus aktiviert."
				StepWaypoint: "[DEV] Wegpunkt gesetzt."
				StepBackpack: "[DEV] Rucksackgegenstand eingefuegt."
			}

			CompanionDebugger: {
				DisplayName: Debugbuch
				Tooltip:
					'''
					Linksklick: Beschwört einen Gefährten an der Mausposition. Erneut benutzen, um den nächsten gespeicherten Gefährten zu rufen.
					Gefährten sind an den Spieler statt an die Welt gebunden und verbrauchen jeweils einen Dienerplatz.
					Rechtsklick: Öffnet die Gefährtenverwaltung. Dort kannst du einzelne oder alle Gefährten entlassen.
					Klicke auf das Gefährtenfeld am oberen Bildschirmrand: Öffnet Ausrüstung und Rucksack.
					Du kannst in den Einstellungen auch „Rechtsklick auf einen Gefährten öffnet seinen Rucksack“ aktivieren, um ihn direkt per Rechtsklick zu öffnen.
					Waffen: Jede Waffe ist möglich, auch Beschwörungswaffen. Die Waffenleiste wird von links nach rechts geprüft; Fernkampfwaffen nutzen bei leerer Munition Standardmunition.

					Technische Hinweise:
					Gefährten sind echte Spielerentitäten in Spielerslots: Waffenanimationen, Ausrüstungseffekte und Bewegungsphysik werden vom Grundspiel verarbeitet.
					Sie folgen dir per Wegfindung — mit Springen, Fliegen und Durchqueren von Plattformen — und teleportieren sich erst nach längerem großem Abstand.
					Wenn du getroffen wirst oder schnell doppelt rechtsklickst, kommen Gefährten zu dir, um dich zu schützen; auch bei Feststecken kehren sie automatisch zurück.
					Da dieses System recht ungewöhnlich ist, wird derzeit nur Einzelspieler unterstützt.
					Einige komplexe oder fortgeschrittene Mod-Waffen sind möglicherweise nicht kompatibel. Eine vollständige Liste gibt es nicht; probiere sie bitte nach und nach aus.
					'''
				RescueShortcut: Doppelklicke auf [{0}], um alle Begleiter schnell zu dir zu rufen.
				RescueDefaultKey: Rechte Maustaste
			}

			CompanionCommandBook: {
				DisplayName: Befehlsbuch
				Tooltip:
					'''
					Rechtsklick halten: Wechselt zwischen den drei Kampfmodi Angriff / Verteidigung / Wache. Der gewählte Modus erscheint über deinem Kopf.
					· Angriff: Folgt frei, greift aktiv an, baut ab und sammelt.
					· Verteidigung: Bleibt als Leibwache dicht bei dir und greift Gegner nicht von selbst an.
					· Wache: Markiert die Position beim Betreten des Modus, kämpft dort und kehrt nach Rückstoß zurück.
					Daneben gibt es drei Nichtkampfmodi: Angeln / Fangen / Bergbau.
					Linksklick: Setzt einen Wegpunkt an der Mausposition. Gefährten gehen dorthin und halten die Stellung; erneuter Linksklick nahe der Markierung hebt sie auf.
					Ein Wegpunkt besteht höchstens 5 Sekunden und verschwindet, wenn er nicht erreicht wird. Nach dem Erreichen bleibt der Gefährte dort bis zu einem neuen Befehl oder Rettungsruf.
					Das Angriffsverhalten ist in allen Modi gleich; nur die Bewegung ändert sich.

					Technische Hinweise:
					Mit der Zeit werden möglichst viele taktische Formen ergänzt, um unterschiedliche Bedürfnisse abzudecken.
					Auch jetzt kann die Wegfindung in kompliziertem Gelände scheitern.
					Probiere ruhig viel aus. Bei Problemen aktualisiere und versuche es erneut; schwere Fehler melde bitte in den Kommentaren.
					Es gibt sicher viele Probleme, die eine Person allein nicht finden kann.
					'''
			}

			CompanionHunterBook: {
				DisplayName: Jägerbuch
				Tooltip:
					'''
					Linksklick: Startet oder beendet die gewählte Jägerprüfung. Die Jäger sammeln sich zuerst in der Ferne.
					Rechtsklick: Wähle 1 bis 3 Jäger und eine Prüfungsregel.
					· Überleben: Halte 180 Sekunden gegen wiederkehrende Jäger durch.
					· Ausschaltung: Besiege die geforderte Anzahl Jäger.
					· Ausbruch: Erreiche binnen 150 Sekunden den fernen Ausgang; Jäger fangen dich unterwegs ab.
					Verfügbar nach einem Boss vor dem Hardmode bis zur Fleischwand sowie im frühen Hardmode bis Plantera.
					Jäger nutzen feste Ausrüstung der Weltphase, nicht deine Verteidigung. Mehr Jäger sind einzeln schwächer.
					'''
			}

			CompanionBuilderBook: {
				DisplayName: Baumeisterbuch
				Tooltip:
					'''
					Hold right click: open the tactic wheel. Left click: switch the selected tactic on or off.
					· Smart Build: while you place the same block along a line, companions continue that block in the same direction from their own or your inventory.
					· Defensive Build: when an enemy is near, companions raise a short blocking pillar between you and the nearest threat.
					· Battle Platform: while you stand on a platform whose facing edge breaks off ahead, companions extend flat platforms across the gap — about six tiles ahead, so keep walking to keep bridging. They will not drop off the bridge, and return to your side if knocked off.
					Builders take non-favourited materials from active companion backpacks first, then your inventory. Work pauses safely if supplies run out.
					Companions never mine or replace blocks. Combat, rescue calls, waypoints and specialist modes always take priority. Single-player only.
					'''
			}

			CompanionAutomationBook: {
				DisplayName: Automatisierungsbuch
				Tooltip:
					'''
					[Nur zur Unterhaltung; diese Funktion befindet sich noch im Test]
					Linksklick: Beschwört deinen einzigen automatischen Begleiter (ein vorhandener wird nie zurückgesetzt oder ersetzt)
					Rechtsklick: Öffnet seinen Rucksack
					Er versucht selbstständig zu erkunden, zu sammeln, zu bauen, zu kämpfen und die Welt voranzutreiben; danach wird er zu einem normalen Phantomgefährten
					Er kann noch stecken bleiben, Fehler machen oder andere Bugs verursachen. Erstelle vorher eine Sicherung der Welt. Nur Einzelspieler.
					'''
			}

			PlayerScaleBook: {
				DisplayName: Kristallmatrix-Buch
				Tooltip: "[Nur zum Spaß] Rechtsklick: Matrix öffnen und Größe wählen. Linksklick: eigene Figur auf diese Größe ändern; erneut klicken, um zu 1× zurückzukehren."
			}
		}

		VanillaItemHints: {

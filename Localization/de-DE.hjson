# Localization file. Keep this UTF-8 (no BOM).
# The filename is just the culture code (en-US), so NO prefix is applied — the
# full "Mods.MoreAIPlayer." path is written out inside. Do NOT rename this to
# "en-US_Mods.MoreAIPlayer.hjson", or the prefix gets doubled and nothing matches.

Mods: {
	MoreAIPlayer: {
		Configs: {
			MoreAIPlayerClientConfig: {
				// DisplayName: Phantom Companion Client Settings
				// Headers.CompanionDiagnostics: Companion Diagnostics

				EnablePhantomPlayerDebugText: {
					// Label: "[i:GoldenKey] Enable Phantom Player Debug Text"
					// Tooltip: Shows the live development readout above phantom companions. Disabled by default.
				}
			}
		}

		Items: {
			DamageTestDummy: {
				DisplayName: Kleines Häschen
				Tooltip:
					'''
					So ein niedliches kleines Häschen.
					Sicher stimmt es zu, mein Waffenschaden-Testwerkzeug zu sein.
					Linksklick: Puppe platzieren. Rechtsklick: Puppen entfernen.
					'''
			}

			DevelopmentNotice: {
				// DisplayName: Phantom Companion Development Notice
				// Development: This mod is actively under development.
				// SoloCreator: It is made and maintained by one creator.
				// Updates: I will keep updating it, improving companions, and fixing problems reported by players.
				// Compatibility: Popular weapons from large mods will receive one-to-one compatibility work over time.
				// Complexity: Similar-looking weapons can use very different code internally; some therefore need much more time to support safely. Thank you for your patience.
				// Tooltip: ""
			}

			CompanionDebugger: {
				DisplayName: Debugbuch
				Tooltip:
					'''
					Linksklick: Beschwört einen Gefährten an der Mausposition. Erneut benutzen, um den nächsten gespeicherten Gefährten zu rufen.
					Gefährten sind an den Spieler statt an die Welt gebunden und verbrauchen jeweils einen Dienerplatz.
					Rechtsklick: Öffnet die Gefährtenverwaltung. Dort kannst du einzelne oder alle Gefährten entlassen.
					Rechtsklick auf einen Gefährten: Öffnet seine Ausrüstung und seinen Rucksack. Du musst kein Item in der Hand halten.
					Waffen: Jede Waffe ist möglich, auch Beschwörungswaffen. Die Waffenleiste wird von links nach rechts geprüft; Fernkampfwaffen nutzen bei leerer Munition Standardmunition.

					Technische Hinweise:
					Gefährten sind echte Spielerentitäten in Spielerslots: Waffenanimationen, Ausrüstungseffekte und Bewegungsphysik werden vom Grundspiel verarbeitet.
					Sie folgen dir per Wegfindung — mit Springen, Fliegen und Durchqueren von Plattformen — und teleportieren sich erst nach längerem großem Abstand.
					Wenn du getroffen wirst oder schnell doppelt rechtsklickst, kommen Gefährten zu dir, um dich zu schützen; auch bei Feststecken kehren sie automatisch zurück.
					Da dieses System recht ungewöhnlich ist, wird derzeit nur Einzelspieler unterstützt.
					Einige komplexe oder fortgeschrittene Mod-Waffen sind möglicherweise nicht kompatibel. Eine vollständige Liste gibt es nicht; probiere sie bitte nach und nach aus.
					'''
			}

			CompanionCommandBook: {
				DisplayName: Befehlsbuch
				Tooltip:
					'''
					Rechtsklick halten: Wechselt zwischen den drei Kampfmodi Angriff / Verteidigung / Wache. Der gewählte Modus erscheint über deinem Kopf.
					· Angriff: Folgt frei, greift aktiv an, baut ab und sammelt.
					· Verteidigung: Bleibt als Leibwache dicht bei dir und greift Gegner nicht von selbst an.
					· Wache: Markiert die Position beim Betreten des Modus, kämpft dort und kehrt nach Rückstoß zurück.
					Daneben gibt es drei Nichtkampfmodi: Angeln / Fangen / Bergbau.
					Linksklick: Setzt einen Wegpunkt an der Mausposition. Gefährten gehen dorthin und halten die Stellung; erneuter Linksklick nahe der Markierung hebt sie auf.
					Ein Wegpunkt besteht höchstens 5 Sekunden und verschwindet, wenn er nicht erreicht wird. Nach dem Erreichen bleibt der Gefährte dort bis zu einem neuen Befehl oder Rettungsruf.
					Das Angriffsverhalten ist in allen Modi gleich; nur die Bewegung ändert sich.

					Technische Hinweise:
					Mit der Zeit werden möglichst viele taktische Formen ergänzt, um unterschiedliche Bedürfnisse abzudecken.
					Auch jetzt kann die Wegfindung in kompliziertem Gelände scheitern.
					Probiere ruhig viel aus. Bei Problemen aktualisiere und versuche es erneut; schwere Fehler melde bitte in den Kommentaren.
					Es gibt sicher viele Probleme, die eine Person allein nicht finden kann.
					'''
			}

			CompanionHunterBook: {
				DisplayName: Jägerbuch
				Tooltip:
					'''
					Hinweis: Dieser Gegenstand wird noch getestet und kann Probleme haben.
					Linksklick: Schaltet den Jagdmodus ein oder aus. Feindliche Jäger nehmen deine Spur auf.
					Rechtsklick: Öffnet die Jagdeinstellungen; wähle 1 bis 3 Jäger.
					Die Ausrüstung der Jäger skaliert mit dem Weltfortschritt und deiner Verteidigung. Im Jagdmodus wird PvP aktiviert.
					Jäger verfolgen dich 2 Minuten lang, ruhen dann 45 Sekunden und setzen die Jagd fort.
					Besiegte Jäger kehren nach 60 Sekunden mit neuer Ausrüstung zurück.
					'''
			}
		}

		CompanionCommand: {
			ModeAttack: Angriffsmodus
			ModeDefense: Verteidigungsmodus
			ModeGarrison: Wachmodus
			Switched: Phantomgefährte: {0}
			NoCompanion: Du hast keine Phantomgefährten beschworen.
			SingleplayerOnly: Phantomgefährten sind derzeit nur im Einzelspieler verfügbar.
			Reviving: "{0} wird in {1}s wiederbelebt"
			NoFreeSlot: Kein freier Spielerslot für einen Phantomgefährten verfügbar.
			MinionSlotsFull: Nicht genug Dienerplätze, um einen Phantomgefährten zu beschwören.
			HunterModeEnabled: "[Jagdmodus] aktiviert! Feindliche Jäger verfolgen deine Spur..."
			HunterModeDisabled: "[Jagdmodus] deaktiviert. Die Warnung ist aufgehoben."
			HunterSpawned: "[Warnung] Der feindliche Spieler {0} ist in deine Welt eingedrungen!"
			HunterDefeated: "[Durchsage] Der feindliche Spieler {0} wurde besiegt! Er kehrt in 60 Sekunden mit neuer Ausrüstung zurück..."
			HunterRespawned: "[Warnung] Der feindliche Spieler {0} ist zurück und nimmt die Jagd wieder auf!"
			HunterSingleplayerOnly: Der Jagdmodus ist derzeit nur im Einzelspieler verfügbar.
			Diagnostics: Phantomdiagnose: {0}  Build {1}
			Enabled: An
			Disabled: Aus
			HunterResting: "[Jägerwarnung] {0} zieht sich zurück, um sich auszuruhen und Vorräte zu sammeln!"
			HunterHunting: "[Jägerwarnung] {0} hat deine Spur wiedergefunden und setzt die Jagd fort!"
			HunterPanelTitle: ⚔ Jagdmodus-Einstellungen
			Close: Schließen
			HunterPanelEnabled: "[Modusstatus] Aktiviert (zum Deaktivieren klicken)"
			HunterPanelDisabled: "[Modusstatus] Deaktiviert (zum Aktivieren klicken)"
			HunterCountTitle: Anzahl der Jäger:
			HunterCount: "{0} Jäger"
			HunterStatusTitle: Jägerstatus:
			HunterInactive: · Jagdmodus ist nicht aktiv
			HunterPanelReviving: · {0}: Wiederbelebung ({1}s verbleiben)
			HunterPanelResting: · {0}: ruht und sammelt Vorräte
			HunterPanelHunting: · {0}: setzt zur Jagd an!
			HunterRefresh: 🔄 Jägertrupp neu erstellen und entsenden
			HunterRefreshed: Jägertrupp wurde neu erstellt und entsandt!
		}

		// NPCs.DamageTestDummyNPC.DisplayName: Damage Test Dummy N P C
	}
}

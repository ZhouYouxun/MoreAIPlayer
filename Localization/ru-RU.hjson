# Localization file. Keep this UTF-8 (no BOM).
# The filename is just the culture code (en-US), so NO prefix is applied — the
# full "Mods.MoreAIPlayer." path is written out inside. Do NOT rename this to
# "en-US_Mods.MoreAIPlayer.hjson", or the prefix gets doubled and nothing matches.

Mods: {
	MoreAIPlayer: {
		Configs: {
			MoreAIPlayerClientConfig: {
				// DisplayName: Phantom Companion Client Settings
				// Headers.CompanionDiagnostics: Companion Diagnostics

				EnablePhantomPlayerDebugText: {
					// Label: "[i:GoldenKey] Enable Phantom Player Debug Text"
					// Tooltip: Shows the live development readout above phantom companions. Disabled by default.
				}
			}
		}

		Items: {
			DamageTestDummy: {
				DisplayName: Кролик
				Tooltip:
					'''
					Какой милый кролик.
					Наверняка он согласится стать моим инструментом для проверки урона оружия.
					Левый щелчок: поставить манекен. Правый щелчок: убрать манекены.
					'''
			}

			DevelopmentNotice: {
				// DisplayName: Phantom Companion Development Notice
				// Development: This mod is actively under development.
				// SoloCreator: It is made and maintained by one creator.
				// Updates: I will keep updating it, improving companions, and fixing problems reported by players.
				// Compatibility: Popular weapons from large mods will receive one-to-one compatibility work over time.
				// Complexity: Similar-looking weapons can use very different code internally; some therefore need much more time to support safely. Thank you for your patience.
				// Tooltip: ""
			}

			CompanionDebugger: {
				DisplayName: Отладочная книга
				Tooltip:
					'''
					ЛКМ: призвать спутника в позицию курсора. Используйте снова, чтобы призвать следующего сохранённого спутника.
					Спутники привязаны к игроку, а не к миру, и каждый занимает слот прислужника.
					ПКМ: открыть менеджер спутников. В нём можно распустить отдельных спутников или всех сразу.
					ПКМ по спутнику: открыть его снаряжение и рюкзак. Не нужно держать какой-либо предмет.
					Оружие: подходит любое оружие, включая призывное. Панель оружия проверяется слева направо; при нехватке боеприпасов дальнобойное оружие использует базовые.

					Технические сведения:
					Спутники — настоящие сущности игроков в слотах игроков: анимации оружия, эффекты экипировки и физика движения обрабатываются оригинальной игрой.
					Они идут за вами по маршруту, прыгая, летая и спускаясь сквозь платформы; телепортируются только после долгого пребывания слишком далеко.
					Получите удар или быстро дважды нажмите ПКМ, чтобы спутники перенеслись к вам на защиту; если они застрянут, то вернутся сами.
					Поскольку эта система довольно необычна, пока поддерживается только одиночная игра.
					Некоторые сложные или продвинутые оружия из других модов могут быть несовместимы. Полного списка нет, поэтому пробуйте их постепенно.
					'''
			}

			CompanionCommandBook: {
				DisplayName: Книга приказов
				Tooltip:
					'''
					Удерживайте ПКМ: переключает три боевых режима Штурм / Оборона / Гарнизон. Выбранный режим появится над вашей головой.
					· Штурм: свободно следует и активно сражается, добывает блоки и собирает предметы.
					· Оборона: держится рядом как телохранитель и не атакует врагов по собственной инициативе.
					· Гарнизон: отмечает место при включении, сражается там и возвращается после отбрасывания.
					Есть ещё три небоевых режима: Рыбалка / Ловля / Добыча.
					ЛКМ: поставить маршрутную точку в позиции курсора. Спутники пойдут туда и будут удерживать позицию; кликните рядом с меткой ещё раз, чтобы отменить её.
					Точка существует не более 5 с и исчезает, если до неё не дошли. По прибытии спутник остаётся там до нового приказа или сигнала спасения.
					Атакующее поведение одинаково во всех режимах — меняется только передвижение.

					Технические сведения:
					Со временем будет добавлено как можно больше тактических форм для разных нужд.
					Даже сейчас поиск пути может дать сбой в сложном рельефе.
					Смело экспериментируйте. Если что-то пошло не так, перезагрузитесь и попробуйте снова; о серьёзных проблемах сообщайте в комментариях.
					Наверняка есть много проблем, которые один человек не сможет обнаружить.
					'''
			}

			CompanionHunterBook: {
				DisplayName: Книга охотников
				Tooltip:
					'''
					Примечание: этот предмет ещё тестируется и может иметь проблемы.
					ЛКМ: включает или выключает режим Охоты. Враждебные охотники начнут идти по вашему следу.
					ПКМ: открывает настройки Охоты; выберите от 1 до 3 охотников.
					Снаряжение охотников зависит от прогресса мира и вашей защиты. Пока режим Охоты активен, включается PvP.
					Охотники преследуют вас 2 минуты, затем отдыхают 45 секунд и продолжают погоню.
					Побеждённые охотники возвращаются через 60 секунд с новым снаряжением.
					'''
			}
		}

		CompanionCommand: {
			ModeAttack: Режим штурма
			ModeDefense: Режим обороны
			ModeGarrison: Режим гарнизона
			Switched: Призрачный спутник: {0}
			NoCompanion: У вас нет призванных призрачных спутников.
			SingleplayerOnly: Призрачные спутники пока доступны только в одиночной игре.
			Reviving: "{0} возрождается через {1}с"
			NoFreeSlot: Нет свободного слота игрока для призрачного спутника.
			MinionSlotsFull: Недостаточно слотов прислужников для призыва призрачного спутника.
			HunterModeEnabled: "[Режим Охоты] включён! Враждебные охотники идут по вашему следу..."
			HunterModeDisabled: "[Режим Охоты] выключен. Тревога отменена."
			HunterSpawned: "[Предупреждение] Враждебный игрок {0} проник в ваш мир!"
			HunterDefeated: "[Объявление] Враждебный игрок {0} побеждён! Он вернётся с новым снаряжением через 60 секунд..."
			HunterRespawned: "[Предупреждение] Враждебный игрок {0} вернулся и возобновляет погоню!"
			HunterSingleplayerOnly: Режим Охоты пока доступен только в одиночной игре.
			Diagnostics: Диагностика спутника: {0}  Сборка {1}
			Enabled: Вкл.
			Disabled: Выкл.
			HunterResting: "[Предупреждение охотника] {0} отступает, чтобы отдохнуть и собрать припасы!"
			HunterHunting: "[Предупреждение охотника] {0} снова нашёл ваш след и возобновляет охоту!"
			HunterPanelTitle: ⚔ Настройки режима Охоты
			Close: Закрыть
			HunterPanelEnabled: "[Состояние режима] Включён (нажмите, чтобы выключить)"
			HunterPanelDisabled: "[Состояние режима] Выключен (нажмите, чтобы включить)"
			HunterCountTitle: Число охотников:
			HunterCount: Охотники: {0}
			HunterStatusTitle: Состояние охотников:
			HunterInactive: · Режим Охоты не активен
			HunterPanelReviving: · {0}: возрождается (осталось {1}с)
			HunterPanelResting: · {0}: отдыхает и собирает припасы
			HunterPanelHunting: · {0}: приближается, чтобы убить вас!
			HunterRefresh: 🔄 Пересобрать и отправить отряд охотников
			HunterRefreshed: Отряд охотников пересобран и отправлен!
		}

		// NPCs.DamageTestDummyNPC.DisplayName: Damage Test Dummy N P C
	}
}

# Localization file. Keep this UTF-8 (no BOM).
# The filename is just the culture code (en-US), so NO prefix is applied — the
# full "Mods.MoreAIPlayer." path is written out inside. Do NOT rename this to
# "en-US_Mods.MoreAIPlayer.hjson", or the prefix gets doubled and nothing matches.

Mods: {
	MoreAIPlayer: {
		Keybinds: {
			// CompanionWheel.DisplayName: Command Wheel
			CompanionRescue.DisplayName: Экстренный призыв спутников
		}

		Fault: {
			SubsystemError: "[Призрачный спутник] Подсистема {0} столкнулась с внутренней ошибкой и пока пропущена. Игра продолжает работать."
			CompanionDisabled: "[Призрачный спутник] Спутник многократно ошибался и был безопасно удалён для защиты игры."
			HunterDisabled: "[Призрачный спутник] Охотник многократно ошибался и был безопасно удалён для защиты игры."
			CircuitOpened: "[Призрачный спутник] {0} столкнулась с ошибкой и приостановлена на эту сессию мира. Остальные системы продолжают работать."
			CircuitStillOpen: "[Призрачный спутник] Рискованная операция остаётся приостановленной после ошибки. Перезагрузите мир перед новой попыткой."
			BackpackDropBlocked: "[Призрачный спутник] Очистить рюкзак по умолчанию отключено для защиты сохранения. Включайте в настройках только после проверки совместимости."
			// BackpackRecovered: "[Phantom Companion] A companion data error was found at {0}. The affected state was cleaned and refreshed automatically."
			// BackpackRecoveryFailed: "[Phantom Companion] A companion error at {0} could not be refreshed safely, so the affected panel was closed. Details were written to the log."
		}

		Configs: {
			MoreAIPlayerServerConfig: {
				DisplayName: Игровые правила призрачных спутников

				OrdinaryCompanionsHostileToPlayers: {
					Label: "[i:BloodyMachete] Обычные спутники могут ранить игроков"
					Tooltip: Спутники любого игрока могут случайно ранить любого игрока, независимо от того, включено ли PvP.
				}
			}

			MoreAIPlayerClientConfig: {
				DisplayName: Клиентские настройки призрачных спутников

				Headers: {
					CompanionDiagnostics: Диагностика спутников
					CompanionBalance: Баланс и выживание спутников
					CompanionPickup: Сбор предметов мира спутниками
					CompanionSafety: Безопасность спутников
				}

				EnablePhantomPlayerDebugText: {
					Label: "[i:GoldenKey] Показывать отладочные данные"
					Tooltip: Показывает отладочные данные разработки.
				}

				ShowCompanionHealthBars: {
					Label: "[i:LifeCrystal] Показывать дополнительную шкалу здоровья"
					Tooltip: Рисует собственную шкалу здоровья этого мода. Включайте, только если стандартная шкала здоровья не работает.
				}

				UseChatForCompanionReviveTimer: {
					Label: "[i:RecallPotion] Сообщения о смерти и возрождении в чате"
					Tooltip: Отправляет сообщение, когда спутник погибает или возрождается.
				}

				AllowRightClickOpenBackpack: {
					Label: "[i:Chest] Открывать рюкзак спутника правой кнопкой"
					Tooltip: Ещё один способ открыть рюкзак; равнозначен прямому нажатию на его вкладку.
				}

				CompanionsFightAfterOwnerDeath: {
					Label: "[i:EnchantedSword] Спутники сражаются после смерти игрока"
					Tooltip: Если выключено, спутники исчезают сразу после вашей смерти.
				}

				CompanionsTakeDamage: {
					Label: "[i:CobaltShield] Спутники получают урон"
					Tooltip: Позволяет спутникам получать обычный урон, погибать и ждать возрождения.
				}

				CompanionsRescueWhenOwnerHurt: {
					Label: "[i:MagicMirror] Призывать спутников при получении урона"
					Tooltip: При получении урона немедленно телепортирует всех спутников к вам.
				}

				ProtectBaseFromCompanionMining: {
					Label: "[i:PeaceCandle] Защита базы"
					Tooltip: Когда включено, спутники не считают разрушаемыми блоки в пределах 200 клеток от точки появления мира.
				}

				ExtraAccessorySlots: {
					Label: "[i:CelestialShell] Дополнительные слоты аксессуаров"
					Tooltip: Позволяет спутникам экипировать больше аксессуаров.
				}

				CompanionsAutoCollectWorldItems: {
					Label: "[i:TreasureMagnet] Автоматически подбирать предметы мира"
					Tooltip: Определяет, могут ли спутники пытаться подбирать любые предметы мира.
				}

				CompanionsAllowBackpackWorldDrops: {
					Label: "[i:TrashCan] Разрешить быстрое опустошение"
					Tooltip: Определяет, опустошается ли рюкзак спутника одним действием. Это может вызвать задержки.
				}
			}
		}

		Items: {
			PhantomStaff: {
				// DisplayName: Phantom Staff
				/* Tooltip:

# Localization file. Keep this UTF-8 (no BOM).
# The filename is just the culture code (en-US), so NO prefix is applied — the
# full "Mods.MoreAIPlayer." path is written out inside. Do NOT rename this to
# "en-US_Mods.MoreAIPlayer.hjson", or the prefix gets doubled and nothing matches.

Mods: {
	MoreAIPlayer: {
		Fault: {
			SubsystemError: "[Призрачный спутник] Подсистема {0} столкнулась с внутренней ошибкой и пока пропущена. Игра продолжает работать."
			CompanionDisabled: "[Призрачный спутник] Спутник многократно ошибался и был безопасно удалён для защиты игры."
			HunterDisabled: "[Призрачный спутник] Охотник многократно ошибался и был безопасно удалён для защиты игры."
			CircuitOpened: "[Призрачный спутник] {0} столкнулась с ошибкой и приостановлена на эту сессию мира. Остальные системы продолжают работать."
			CircuitStillOpen: "[Призрачный спутник] Рискованная операция остаётся приостановленной после ошибки. Перезагрузите мир перед новой попыткой."
			BackpackDropBlocked: "[Призрачный спутник] Очистить рюкзак по умолчанию отключено для защиты сохранения. Включайте в настройках только после проверки совместимости."
		}

		Configs: {
			MoreAIPlayerClientConfig: {
				DisplayName: Клиентские настройки призрачных спутников

				Headers: {
					CompanionDiagnostics: Диагностика спутников
					CompanionBalance: Баланс и выживание спутников
					CompanionPickup: Сбор предметов мира спутниками
					CompanionSafety: Безопасность спутников
				}

				EnablePhantomPlayerDebugText: {
					Label: "[i:GoldenKey] Включить отладочный текст призрачных игроков"
					Tooltip: Показывает над призрачными спутниками текущие данные разработки. По умолчанию выключено.
				}

				ShowCompanionHealthBars: {
					// Label: "[i:LifeCrystal] Show companion health bars"
					// Tooltip: Disabled by default. Companions occupy real player slots, so the game already draws a health bar over them. Enable to also show the mod's own bar below each companion.
				}

				AllowRightClickOpenBackpack: {
					// Label: "[i:Chest] Right-click a companion to open its backpack"
					// Tooltip: Disabled by default. When off, right-clicking a companion does nothing and the backpack opens only through the matrix panel at the top of the screen. Enable to open it by right-clicking the companion.
				}

				CompanionsFightAfterOwnerDeath: {
					Label: "[i:EnchantedSword] Спутники сражаются после смерти игрока"
					Tooltip: Включено по умолчанию. Если вы погибнете во время битвы с боссом, связанные спутники останутся и продолжат сражаться. Отключите, чтобы сразу распустить их после смерти.
				}

				CompanionsTakeDamage: {
					Label: "[i:CobaltShield] Спутники получают урон"
					Tooltip: По умолчанию выключено. Включите, чтобы спутники получали обычный урон, могли погибнуть и возрождались после обычной задержки. Пока выключено, они неуязвимы для любого урона.
				}

				CompanionsAutoCollectWorldItems: {
					Label: "[i:TreasureMagnet] Спутники автоматически собирают предметы мира"
					Tooltip: По умолчанию выключено. Пока опция выключена, спутники не ищут, не резервируют, не преследуют и не собирают предметы мира. Включайте её только после проверки совместимости с сохранением и другими модами.
				}

				CompanionsAllowBackpackWorldDrops: {
					Label: "[i:TrashCan] Разрешить спутникам выбрасывать предметы рюкзака в мир"
					Tooltip: По умолчанию выключено. Очистить рюкзак создаёт предметы мира и может вызвать хуки других модов. Включайте только после подтверждения стабильности сохранения.
				}
			}
		}

		Keybinds.CompanionRescue.DisplayName: Экстренный призыв спутников

		Items: {
			DamageTestDummy: {
				DisplayName: Кролик
				Tooltip:
					'''
					Какой милый кролик.
					Наверняка он согласится стать моим инструментом для проверки урона оружия.
					Левый щелчок: поставить манекен. Правый щелчок: убрать манекены.
					'''
			}

			DevelopmentNotice: {
				DisplayName: Сведения о разработке призрачных спутников
				Development: Этот мод находится в активной разработке.
				SoloCreator: Он создаётся и поддерживается одним человеком.
				Updates: Я буду продолжать обновлять его, улучшать спутников и исправлять проблемы, о которых сообщают игроки.
				Compatibility: Популярное оружие из крупных модов со временем получит отдельную поддержку совместимости.
				Complexity: Похожее оружие может иметь совершенно разные внутренние механики, поэтому некоторым экземплярам требуется гораздо больше времени для безопасной поддержки. Спасибо за терпение.
				ConfigSuggestion: Загляните в параметры конфигурации.
				Tooltip: Сведения о разработке и параметрах конфигурации.
			}

			CompanionDevelopmentBook: {
				DisplayName: Kniga razrabotki
				Tooltip:
					'''
					Levyy klik zapuskaet seriyu otladochnykh testov.
					Testy vypolnyayutsya avtomaticheski.
					-- Predmet razrabotchika --
					'''
				Started: Test razrabotki zapushchen.
				Stopped: Test razrabotki ostanovlen i ochishchen.
				Completed: Test razrabotki zavershen i ochishchen.
				Failed: Test razrabotki prervan; vremennyy sputnik ochishchen.
				StepSummon: "[DEV] Vremennyy sputnik prizvan."
				StepAttack: "[DEV] Vklyuchen rezhim ataki."
				StepEscort: "[DEV] Vklyuchen rezhim soprovozhdeniya."
				StepGarrison: "[DEV] Vklyuchen garnizonnyy rezhim."
				StepCatch: "[DEV] Vklyuchen rezhim lovli."
				StepFishing: "[DEV] Vklyuchen rezhim rybalki."
				StepMining: "[DEV] Vklyuchen rezhim dobychi."
				StepWaypoint: "[DEV] Put' zadana."
				StepBackpack: "[DEV] Predmet dobavlen v ryukzak."
			}

			CompanionDebugger: {
				DisplayName: Отладочная книга
				Tooltip:
					'''
					ЛКМ: призвать спутника в позицию курсора. Используйте снова, чтобы призвать следующего сохранённого спутника.
					Спутники привязаны к игроку, а не к миру, и каждый занимает слот прислужника.
					ПКМ: открыть менеджер спутников. В нём можно распустить отдельных спутников или всех сразу.
					Нажмите на панель спутников в верхней части экрана: откроются снаряжение и рюкзак.
					Также можно включить в настройках «ПКМ по спутнику открывает рюкзак», чтобы открывать его напрямую правым кликом по спутнику.
					Оружие: подходит любое оружие, включая призывное. Панель оружия проверяется слева направо; при нехватке боеприпасов дальнобойное оружие использует базовые.

					Технические сведения:
					Спутники — настоящие сущности игроков в слотах игроков: анимации оружия, эффекты экипировки и физика движения обрабатываются оригинальной игрой.
					Они идут за вами по маршруту, прыгая, летая и спускаясь сквозь платформы; телепортируются только после долгого пребывания слишком далеко.
					Получите удар или быстро дважды нажмите ПКМ, чтобы спутники перенеслись к вам на защиту; если они застрянут, то вернутся сами.
					Поскольку эта система довольно необычна, пока поддерживается только одиночная игра.
					Некоторые сложные или продвинутые оружия из других модов могут быть несовместимы. Полного списка нет, поэтому пробуйте их постепенно.
					'''
				RescueShortcut: Дважды нажмите [{0}], чтобы быстро призвать всех спутников к себе.
				RescueDefaultKey: Правая кнопка мыши
			}

			CompanionCommandBook: {
				DisplayName: Книга приказов
				Tooltip:
					'''
					Удерживайте ПКМ: переключает три боевых режима Штурм / Оборона / Гарнизон. Выбранный режим появится над вашей головой.
					· Штурм: свободно следует и активно сражается, добывает блоки и собирает предметы.
					· Оборона: держится рядом как телохранитель и не атакует врагов по собственной инициативе.
					· Гарнизон: отмечает место при включении, сражается там и возвращается после отбрасывания.
					Есть ещё три небоевых режима: Рыбалка / Ловля / Добыча.
					ЛКМ: поставить маршрутную точку в позиции курсора. Спутники пойдут туда и будут удерживать позицию; кликните рядом с меткой ещё раз, чтобы отменить её.
					Точка существует не более 5 с и исчезает, если до неё не дошли. По прибытии спутник остаётся там до нового приказа или сигнала спасения.
					Атакующее поведение одинаково во всех режимах — меняется только передвижение.

					Технические сведения:
					Со временем будет добавлено как можно больше тактических форм для разных нужд.
					Даже сейчас поиск пути может дать сбой в сложном рельефе.
					Смело экспериментируйте. Если что-то пошло не так, перезагрузитесь и попробуйте снова; о серьёзных проблемах сообщайте в комментариях.
					Наверняка есть много проблем, которые один человек не сможет обнаружить.
					'''
			}

			CompanionHunterBook: {
				DisplayName: Книга охотников
				Tooltip:
					'''
					Примечание: этот предмет ещё тестируется и может иметь проблемы.
					ЛКМ: включает или выключает режим Охоты. Враждебные охотники начнут идти по вашему следу.
					ПКМ: открывает настройки Охоты; выберите от 1 до 3 охотников.
					Снаряжение охотников зависит от прогресса мира и вашей защиты. Пока режим Охоты активен, включается PvP.
					Охотники преследуют вас 2 минуты, затем отдыхают 45 секунд и продолжают погоню.
					Побеждённые охотники возвращаются через 60 секунд с новым снаряжением.
					'''
			}

			CompanionBuilderBook: {
				DisplayName: Книга зодчего
				Tooltip:
					'''
					ПКМ: переключать пять чертежей. ЛКМ: выполнить выбранный. Вниз + ЛКМ: отменить все работы.
					· Умная помощь: включает постоянную поддержку. Спутники запоминают поставленные блоки и стены и продолжают короткие, понятные узоры.
					· Мост: строит горизонтальный мост из платформ длиной до 160 клеток к курсору.
					· Укрытие: строит каркас 11 × 7 с проёмом в три клетки и при наличии материалов добавляет стены и свет.
					· Арена: строит три ряда по 61 платформе с промежутком в десять клеток и доступным освещением.
					· Верёвочная шахта: прокладывает до 120 клеток верёвки по вертикали и ставит свет там, где есть опора.
					Сначала расходуются неизбранные материалы из рюкзаков активных спутников, затем из вашего инвентаря. Без материалов работа безопасно приостанавливается.
					Спутники никогда не добывают и не заменяют блоки. Бой, спасение, путевые точки и специальные режимы всегда важнее. Только одиночная игра.
					'''
			}

			PlayerScaleBook: {
				DisplayName: Книга кристальной матрицы
				Tooltip: "[Только для веселья] ПКМ: открыть матрицу и выбрать масштаб. ЛКМ: применить его; нажмите снова, чтобы вернуться к 1×."
			}
		}

		VanillaItemHints: {
			LifeCrystal: "[Призрачный спутник] Не нужно использовать на спутнике: его максимальное здоровье напрямую повторяет здоровье игрока."
			ManaCrystal: "[Призрачный спутник] Не нужно использовать на спутнике: его максимальная мана напрямую повторяет ману игрока."
		}


# Localization file. Keep this UTF-8 (no BOM).
# The filename is just the culture code (en-US), so NO prefix is applied — the
# full "Mods.MoreAIPlayer." path is written out inside. Do NOT rename this to
# "en-US_Mods.MoreAIPlayer.hjson", or the prefix gets doubled and nothing matches.

Mods: {
	MoreAIPlayer: {
		Fault: {
			SubsystemError: "[Companheiro Fantasma] O subsistema {0} encontrou um erro interno e foi ignorado por enquanto. O jogo continua normalmente."
			CompanionDisabled: "[Companheiro Fantasma] Um companheiro continuou falhando e foi removido com segurança para proteger o jogo."
			HunterDisabled: "[Companheiro Fantasma] Um caçador continuou falhando e foi removido com segurança para proteger o jogo."
			CircuitOpened: "[Companheiro Fantasma] {0} encontrou um erro e foi pausado nesta sessão do mundo. Os demais sistemas permanecem ativos."
			CircuitStillOpen: "[Companheiro Fantasma] Uma operação arriscada permanece pausada após um erro. Recarregue o mundo antes de tentar de novo."
			BackpackDropBlocked: "[Companheiro Fantasma] Esvaziar mochila vem desativado por padrão para proteger seu mundo. Ative nas configurações somente após verificar a compatibilidade."
		}

		Configs: {
			MoreAIPlayerServerConfig: {
				DisplayName: Regras de jogo dos Companheiros Fantasmas

				OrdinaryCompanionsHostileToPlayers: {
					Label: "[i:BloodyMachete] Companheiros comuns podem ferir jogadores"
					Tooltip: Desativado por padrão e destinado apenas a diversão e testes. Afeta somente companheiros comuns invocados pelo livro de depuração. Eles continuam aliados entre si e miram apenas NPCs hostis. Jogadores podem feri-los, e suas armas ou projéteis podem ferir jogadores por contato. Caçadores e companheiros automáticos atuais ou antigos ficam de fora.
				}
			}

			MoreAIPlayerClientConfig: {
				DisplayName: Configurações de cliente dos Companheiros Fantasmas

				Headers: {
					CompanionDiagnostics: Diagnóstico dos companheiros
					CompanionBalance: Equilíbrio e sobrevivência dos companheiros
					CompanionPickup: Coleta de itens do mundo pelos companheiros
					CompanionSafety: Segurança dos companheiros
				}

				EnablePhantomPlayerDebugText: {
					Label: "[i:GoldenKey] Ativar texto de depuração de jogadores fantasma"
					Tooltip: Mostra leituras de desenvolvimento em tempo real sobre os companheiros fantasma. Desativado por padrão.
				}

				ShowCompanionHealthBars: {
					// Label: "[i:LifeCrystal] Show companion health bars"
					// Tooltip: Disabled by default. Companions occupy real player slots, so the game already draws a health bar over them. Enable to also show the mod's own bar below each companion.
				}

				AllowRightClickOpenBackpack: {
					// Label: "[i:Chest] Right-click a companion to open its backpack"
					// Tooltip: Disabled by default. When off, right-clicking a companion does nothing and the backpack opens only through the matrix panel at the top of the screen. Enable to open it by right-clicking the companion.
				}

				CompanionsFightAfterOwnerDeath: {
					Label: "[i:EnchantedSword] Companheiros lutam após a morte do jogador"
					Tooltip: Ativado por padrão. Se você morrer durante um chefe, os companheiros vinculados permanecem e continuam lutando. Desative para dispensá-los imediatamente ao morrer.
				}

				CompanionsTakeDamage: {
					Label: "[i:CobaltShield] Companheiros recebem dano"
					Tooltip: Desativado por padrão. Ative para que os companheiros recebam dano normal, possam morrer e revivam após o tempo normal. Quando desativado, eles ficam imunes a todo dano.
				}

				CompanionsRescueWhenOwnerHurt: {
					Label: "[i:MagicMirror] Chamar companheiros ao sofrer dano"
					Tooltip: Desativado por padrão. Os companheiros se teleportam para locais seguros e separados perto de você.
				}

				CompanionsAutoCollectWorldItems: {
					Label: "[i:TreasureMagnet] Companheiros coletam itens do mundo automaticamente"
					Tooltip: Desativado por padrão. Quando desligado, os companheiros não examinam, reservam, perseguem nem coletam itens do mundo. Ative somente após confirmar a compatibilidade com seu mundo e outros mods.
				}

				CompanionsAllowBackpackWorldDrops: {
					Label: "[i:TrashCan] Permitir que companheiros soltem itens da mochila no mundo"
					Tooltip: Desativado por padrão. Esvaziar mochila cria itens no mundo e pode chamar hooks de outros mods. Ative somente após confirmar que o salvamento está estável.
				}
			}
		}

		Keybinds.CompanionRescue.DisplayName: Chamada de emergência dos companheiros

		Items: {
			DamageTestDummy: {
				DisplayName: Coelhinho
				Tooltip:
					'''
					Que coelhinho adorável.
					Certamente ele aceita ser minha ferramenta para testar o dano de armas.
					Clique esquerdo: coloque um boneco. Clique direito: limpe os bonecos.
					'''
			}

			DevelopmentNotice: {
				DisplayName: Aviso de desenvolvimento dos Companheiros Fantasmas
				Development: Este mod continua em desenvolvimento ativo.
				SoloCreator: Ele é criado e mantido por uma única pessoa.
				Updates: Continuarei a atualizá-lo, melhorar os companheiros e corrigir os problemas relatados pelos jogadores.
				Compatibility: Armas populares de grandes mods receberão suporte de compatibilidade individual ao longo do tempo.
				Complexity: Armas de aparência semelhante podem usar mecanismos internos muito diferentes; por isso algumas precisam de muito mais tempo para receber suporte seguro. Agradeço a sua paciência.
				ConfigSuggestion: Considere verificar as opções de configuração.
				Tooltip: Informações sobre o desenvolvimento e as opções de configuração.
			}

			CompanionDevelopmentBook: {
				DisplayName: Livro de desenvolvimento
				Tooltip:
					'''
					Clique esquerdo para executar uma serie de testes de depuracao.
					Os testes serao executados automaticamente.
					-- Item de desenvolvedor --
					'''
				Started: Teste de desenvolvimento iniciado.
				Stopped: Teste de desenvolvimento interrompido e limpo.
				Completed: Teste de desenvolvimento concluido e limpo.
				Failed: Teste de desenvolvimento interrompido; o companheiro temporario foi limpo.
				StepSummon: "[DEV] Companheiro temporario invocado."
				StepAttack: "[DEV] Alternado para o modo de ataque."
				StepEscort: "[DEV] Alternado para o modo de escolta."
				StepGarrison: "[DEV] Alternado para o modo de guarnicao."
				StepCatch: "[DEV] Alternado para o modo de captura."
				StepFishing: "[DEV] Alternado para o modo de pesca."
				StepMining: "[DEV] Alternado para o modo de mineracao."
				StepWaypoint: "[DEV] Ponto de rota definido."
				StepBackpack: "[DEV] Item inserido na mochila."
			}

			CompanionDebugger: {
				DisplayName: Livro de depuração
				Tooltip:
					'''
					Clique esquerdo: invoca um companheiro na posição do cursor. Use de novo para invocar o próximo companheiro salvo.
					Companheiros ficam vinculados ao jogador, não ao mundo, e cada um consome um espaço de lacaio.
					Clique direito: abre o gerenciador de companheiros. Nele, você pode dispensar alguns companheiros ou todos de uma vez.
					Clique no painel de companheiros no topo da tela: abre os equipamentos e a mochila.
					Você também pode ativar em Configurações «Clique direito em um companheiro para abrir a mochila» para abri-la diretamente com o clique direito no companheiro.
					Armas: qualquer arma é aceita, inclusive armas de invocação. A barra de armas é verificada da esquerda para a direita; armas à distância usam munição básica quando ela acaba.

					Notas técnicas:
					Companheiros são entidades de jogador reais registradas em espaços de jogador: animações de armas, efeitos de equipamentos e física de movimento são processados pelo jogo base.
					Eles seguem você por busca de caminho, pulando, voando e atravessando plataformas; só se teletransportam depois de ficarem muito longe por algum tempo.
					Leve um golpe ou dê dois cliques direitos rápidos para chamá-los para protegê-lo; eles também voltam sozinhos se ficarem presos.
					Como este sistema é relativamente incomum, por enquanto ele só funciona no modo solo.
					Algumas armas complexas ou avançadas de outros mods podem não ser compatíveis. Não há uma lista completa; experimente aos poucos.
					'''
				RescueShortcut: Clique duas vezes em [{0}] para chamar rapidamente todos os companheiros para perto de você.
				RescueDefaultKey: Botão direito do mouse
			}

			CompanionCommandBook: {
				DisplayName: Livro de comandos
				Tooltip:
					'''
					Segure o clique direito: alterna entre os três modos de combate Ataque / Defesa / Guarnição. O modo escolhido aparece sobre sua cabeça.
					· Ataque: segue livremente e ataca, minera e coleta ativamente.
					· Defesa: fica perto como guarda-costas e não ataca inimigos por iniciativa própria.
					· Guarnição: marca o local ao entrar no modo, luta ali e retorna se for empurrado para longe.
					Também há três modos não combativos: Pesca / Captura / Mineração.
					Clique esquerdo: coloca um ponto de rota no cursor. Os companheiros vão até lá e mantêm a posição; clique de novo perto do marcador para cancelá-lo.
					Um ponto de rota dura no máximo 5 s e desaparece se não for alcançado. Ao chegar, o companheiro fica lá até receber uma nova ordem ou um chamado de resgate.
					O comportamento de ataque é igual em todos os modos; só o movimento muda.

					Notas técnicas:
					Com o tempo serão adicionadas o máximo possível de formas táticas para atender a necessidades diferentes.
					Mesmo agora, a busca de caminho pode falhar em terrenos complexos.
					Experimente à vontade. Se algo der errado, recarregue e tente de novo; para problemas sérios, informe nos comentários.
					Certamente há muitos problemas que uma pessoa só não consegue descobrir.
					'''
			}

			CompanionHunterBook: {
				DisplayName: Livro dos caçadores
				Tooltip:
					'''
					Clique esquerdo: inicia ou abandona a Prova dos caçadores escolhida. Eles se reúnem primeiro à distância.
					Clique direito: escolha de 1 a 3 caçadores e uma regra.
					· Sobrevivência: resista 180 segundos contra caçadores que voltam após serem derrotados.
					· Eliminação: derrote a quantidade exigida de caçadores.
					· Fuga: alcance uma saída distante em 150 segundos; os caçadores interceptam sua rota.
					Disponível após um chefe pré-Hardmode até a Parede de Carne e no início do Hardmode até Plantera.
					O equipamento depende da fase do mundo, nunca da sua defesa. Mais caçadores significa indivíduos mais fracos.
					'''
			}

			CompanionBuilderBook: {
				DisplayName: Tomo do Arquiteto
				Tooltip:
					'''
					Hold right click: open the tactic wheel. Left click: switch the selected tactic on or off.
					· Smart Build: while you place the same block along a line, companions continue that block in the same direction from their own or your inventory.
					· Defensive Build: when an enemy is near, companions raise a short blocking pillar between you and the nearest threat.
					· Battle Platform: while you stand on a platform whose facing edge breaks off ahead, companions extend flat platforms across the gap — about six tiles ahead, so keep walking to keep bridging. They will not drop off the bridge, and return to your side if knocked off.
					Builders take non-favourited materials from active companion backpacks first, then your inventory. Work pauses safely if supplies run out.
					Companions never mine or replace blocks. Combat, rescue calls, waypoints and specialist modes always take priority. Single-player only.
					'''
			}

			CompanionAutomationBook: {
				DisplayName: Tomo Automático
				Tooltip:
					'''
					[Apenas para entretenimento; este recurso ainda está em testes]
					Clique esquerdo: invoca seu único companheiro automático (um existente nunca será reiniciado ou substituído)
					Clique direito: abre a mochila dele
					Ele tentará explorar, coletar, construir, lutar e avançar pelo mundo de forma independente; ao concluir, torna-se um companheiro fantasma normal
					Ainda pode travar, errar ou encontrar outros bugs. Faça backup do mundo antes. Somente um jogador.
					'''
			}

			PlayerScaleBook: {
				DisplayName: Tomo da Matriz de Cristal
				Tooltip: "[Só por diversão] Clique direito: abra a matriz e escolha a escala. Clique esquerdo: aplique-a; clique de novo para voltar a 1×."
			}
		}


# Localization file. Keep this UTF-8 (no BOM).
# The filename is just the culture code (en-US), so NO prefix is applied — the
# full "Mods.MoreAIPlayer." path is written out inside. Do NOT rename this to
# "en-US_Mods.MoreAIPlayer.hjson", or the prefix gets doubled and nothing matches.

Mods: {
	MoreAIPlayer: {
		Configs: {
			MoreAIPlayerClientConfig: {
				DisplayName: Configurações de cliente dos Companheiros Fantasmas

				Headers: {
					CompanionDiagnostics: Diagnóstico dos companheiros
					CompanionBalance: Equilíbrio e sobrevivência dos companheiros
					CompanionPickup: Coleta de itens do mundo pelos companheiros
				}

				EnablePhantomPlayerDebugText: {
					Label: "[i:GoldenKey] Ativar texto de depuração de jogadores fantasma"
					Tooltip: Mostra leituras de desenvolvimento em tempo real sobre os companheiros fantasma. Desativado por padrão.
				}

				CompanionsFightAfterOwnerDeath: {
					Label: Companheiros lutam após a morte do jogador
					Tooltip: Ativado por padrão. Se você morrer durante um chefe, os companheiros vinculados permanecem e continuam lutando. Desative para dispensá-los imediatamente ao morrer.
				}

				CompanionsTakeDamage: {
					Label: Companheiros recebem dano
					Tooltip: Ativado por padrão. Companheiros recebem dano, podem morrer e revivem após o tempo normal. Desative para torná-los imunes a todo dano.
				}

				CompanionsAutoCollectWorldItems: {
					Label: Companheiros coletam itens do mundo automaticamente
					Tooltip: Desativado por padrão. Quando desligado, os companheiros não examinam, reservam, perseguem nem coletam itens do mundo. Ative somente após confirmar a compatibilidade com seu mundo e outros mods.
				}
			}
		}

		Items: {
			DamageTestDummy: {
				DisplayName: Coelhinho
				Tooltip:
					'''
					Que coelhinho adorável.
					Certamente ele aceita ser minha ferramenta para testar o dano de armas.
					Clique esquerdo: coloque um boneco. Clique direito: limpe os bonecos.
					'''
			}

			DevelopmentNotice: {
				DisplayName: Aviso de desenvolvimento dos Companheiros Fantasmas
				Development: Este mod continua em desenvolvimento ativo.
				SoloCreator: Ele é criado e mantido por uma única pessoa.
				Updates: Continuarei a atualizá-lo, melhorar os companheiros e corrigir os problemas relatados pelos jogadores.
				Compatibility: Armas populares de grandes mods receberão suporte de compatibilidade individual ao longo do tempo.
				Complexity: Armas de aparência semelhante podem usar mecanismos internos muito diferentes; por isso algumas precisam de muito mais tempo para receber suporte seguro. Agradeço a sua paciência.
				ConfigSuggestion: Considere verificar as opções de configuração.
				Tooltip: Informações sobre o desenvolvimento e as opções de configuração.
			}

			CompanionDebugger: {
				DisplayName: Livro de depuração
				Tooltip:
					'''
					Clique esquerdo: invoca um companheiro na posição do cursor. Use de novo para invocar o próximo companheiro salvo.
					Companheiros ficam vinculados ao jogador, não ao mundo, e cada um consome um espaço de lacaio.
					Clique direito: abre o gerenciador de companheiros. Nele, você pode dispensar alguns companheiros ou todos de uma vez.
					Clique direito em um companheiro: abre seus equipamentos e sua mochila. Não é preciso segurar item algum.
					Armas: qualquer arma é aceita, inclusive armas de invocação. A barra de armas é verificada da esquerda para a direita; armas à distância usam munição básica quando ela acaba.

					Notas técnicas:
					Companheiros são entidades de jogador reais registradas em espaços de jogador: animações de armas, efeitos de equipamentos e física de movimento são processados pelo jogo base.
					Eles seguem você por busca de caminho, pulando, voando e atravessando plataformas; só se teletransportam depois de ficarem muito longe por algum tempo.
					Leve um golpe ou dê dois cliques direitos rápidos para chamá-los para protegê-lo; eles também voltam sozinhos se ficarem presos.
					Como este sistema é relativamente incomum, por enquanto ele só funciona no modo solo.
					Algumas armas complexas ou avançadas de outros mods podem não ser compatíveis. Não há uma lista completa; experimente aos poucos.
					'''
			}

			CompanionCommandBook: {
				DisplayName: Livro de comandos
				Tooltip:
					'''
					Segure o clique direito: alterna entre os três modos de combate Ataque / Defesa / Guarnição. O modo escolhido aparece sobre sua cabeça.
					· Ataque: segue livremente e ataca, minera e coleta ativamente.
					· Defesa: fica perto como guarda-costas e não ataca inimigos por iniciativa própria.
					· Guarnição: marca o local ao entrar no modo, luta ali e retorna se for empurrado para longe.
					Também há três modos não combativos: Pesca / Captura / Mineração.
					Clique esquerdo: coloca um ponto de rota no cursor. Os companheiros vão até lá e mantêm a posição; clique de novo perto do marcador para cancelá-lo.
					Um ponto de rota dura no máximo 5 s e desaparece se não for alcançado. Ao chegar, o companheiro fica lá até receber uma nova ordem ou um chamado de resgate.
					O comportamento de ataque é igual em todos os modos; só o movimento muda.

					Notas técnicas:
					Com o tempo serão adicionadas o máximo possível de formas táticas para atender a necessidades diferentes.
					Mesmo agora, a busca de caminho pode falhar em terrenos complexos.
					Experimente à vontade. Se algo der errado, recarregue e tente de novo; para problemas sérios, informe nos comentários.
					Certamente há muitos problemas que uma pessoa só não consegue descobrir.
					'''
			}

			CompanionHunterBook: {
				DisplayName: Livro dos caçadores
				Tooltip:
					'''
					Nota: este item ainda está em teste e pode apresentar problemas.
					Clique esquerdo: ativa ou desativa o modo Caçada. Caçadores hostis seguirão seu rastro.
					Clique direito: abre as configurações de Caçada e permite escolher de 1 a 3 caçadores.
					O equipamento dos caçadores escala com o progresso do mundo e sua defesa. O modo Caçada ativa PvP enquanto estiver ativo.
					Os caçadores perseguem você por 2 minutos, descansam 45 segundos e então retomam a caçada.
					Caçadores derrotados voltam após 60 segundos com equipamentos novos.
					'''
			}

			CompanionBuilderBook: {
				DisplayName: Tomo do Arquiteto
				Tooltip:
					'''
					Clique direito: alterna entre cinco projetos. Clique esquerdo: executa o escolhido. Baixo + clique esquerdo: cancela todos os trabalhos.
					· Assistência inteligente: ativa a ajuda contínua. Os companheiros aprendem os blocos e paredes colocados e prolongam padrões curtos e claros.
					· Ponte: constrói uma ponte horizontal de plataformas de até 160 blocos na direção do cursor.
					· Abrigo: constrói uma estrutura 11 × 7 com entrada de três blocos e adiciona paredes e luzes quando houver materiais.
					· Arena: constrói três fileiras de 61 plataformas separadas por dez blocos, usando a iluminação disponível.
					· Poço de corda: coloca até 120 blocos de corda vertical e luzes onde houver apoio.
					Materiais não favoritos são consumidos primeiro das mochilas dos companheiros ativos e depois do seu inventário. Sem materiais, a obra pausa com segurança.
					Eles nunca mineram nem substituem blocos. Combate, resgate, pontos de destino e modos especializados sempre têm prioridade. Apenas um jogador.
					'''
			}

			PlayerScaleBook: {
				DisplayName: Tomo da Matriz de Cristal
				Tooltip: "[Só por diversão] Clique direito: abra a matriz e escolha a escala. Clique esquerdo: aplique-a; clique de novo para voltar a 1×."
			}
		}

		VanillaItemHints: {
			LifeCrystal: "[Companheiro fantasma] Não precisa usar no companheiro; a vida máxima dele copia diretamente a do jogador."
			ManaCrystal: "[Companheiro fantasma] Não precisa usar no companheiro; o mana máximo dele copia diretamente o do jogador."
		}


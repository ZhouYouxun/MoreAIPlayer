# Localization file. Keep this UTF-8 (no BOM).
# The filename is just the culture code (en-US), so NO prefix is applied — the
# full "Mods.MoreAIPlayer." path is written out inside. Do NOT rename this to
# "en-US_Mods.MoreAIPlayer.hjson", or the prefix gets doubled and nothing matches.

Mods: {
	MoreAIPlayer: {
		Keybinds: {
			CompanionWheel.DisplayName: 轮盘
			CompanionRescue.DisplayName: 伙伴紧急呼唤
		}

		Fault: {
			SubsystemError: "[幻影伙伴] 子系统 {0} 内部出错，已暂时跳过本次运行；游戏继续正常运行。"
			CompanionDisabled: "[幻影伙伴] 一个伙伴反复出错，已被安全移除以保护游戏。"
			HunterDisabled: "[幻影伙伴] 一个猎人反复出错，已被安全移除以保护游戏。"
			CircuitOpened: "[幻影伙伴] {0} 出错，已在本次世界会话中暂停；其他伙伴功能仍会继续运行。"
			CircuitStillOpen: "[幻影伙伴] 某项高风险伙伴操作因先前错误而保持暂停。请重载世界后再尝试。"
			BackpackDropBlocked: "[幻影伙伴] 为保护存档，伙伴背包的“全部丢出”默认关闭。确认兼容性后可在配置中手动开启。"
			BackpackRecovered: "[幻影伙伴] 在 {0} 检测到伙伴数据错误，已自动清理受影响状态并刷新。"
			BackpackRecoveryFailed: "[幻影伙伴] {0} 的伙伴错误无法安全刷新，已关闭受影响界面；详细来源已写入日志。"
		}

		Configs: {
			MoreAIPlayerServerConfig: {
				DisplayName: 幻影伙伴玩法设置

				OrdinaryCompanionsHostileToPlayers: {
					Label: "[i:BloodyMachete] 普通伙伴可误伤玩家"
					Tooltip: 默认关闭，仅供娱乐与测试。只影响调试书召唤的普通幻影伙伴；它们彼此为友军，依然只主动锁定敌对 NPC。玩家可以伤害它们，而它们的物品或弹幕攻击接触玩家时也会造成伤害。猎人以及当前或曾经的自动伙伴均不受影响。
				}
			}

			MoreAIPlayerClientConfig: {
				DisplayName: 幻影伙伴客户端设置

				Headers: {
					CompanionDiagnostics: 伙伴调试
					CompanionBalance: 伙伴平衡与生存
					CompanionPickup: 伙伴拾取世界掉落物
					CompanionSafety: 伙伴安全保护
				}

				EnablePhantomPlayerDebugText: {
					Label: "[i:GoldenKey] 开启幻影玩家的调试文本"
					Tooltip: 在幻影伙伴头顶显示实时开发调试读数。默认关闭，仅在需要排查问题时手动开启。
				}

				ShowCompanionHealthBars: {
					Label: "[i:LifeCrystal] 显示伙伴血条"
					Tooltip: 默认关闭。伙伴占用真实玩家槽位，游戏本身已经会在其头顶画一条血条；开启后会额外在每个伙伴脚下再画一条本模组自己的血条。
				}

				UseChatForCompanionReviveTimer: {
					Label: "[i:RecallPotion] 在聊天栏提示伙伴复活"
					Tooltip: 默认关闭，继续在玩家头顶显示当前倒计时；开启后改为阵亡时和复活时各发送一条聊天提示。
				}

				AllowRightClickOpenBackpack: {
					Label: "[i:Chest] 右键幻影玩家打开其背包"
					Tooltip: 默认关闭。关闭时右键点击幻影玩家不会有任何反应，只能通过屏幕顶部的矩阵小框来打开背包；开启后即可像之前一样右键幻影玩家打开背包。
				}

				CompanionsFightAfterOwnerDeath: {
					Label: "[i:EnchantedSword] 主控死亡后伙伴继续战斗"
					Tooltip: 默认开启。Boss 战中主控玩家死亡后，已绑定的伙伴会留在场上继续战斗；关闭后，主控死亡时其所有已召唤伙伴都会立刻解散。
				}

				CompanionsTakeDamage: {
					Label: "[i:CobaltShield] 伙伴会受到伤害"
					Tooltip: 默认关闭。开启后伙伴会正常受伤、死亡，并在原有等待时间后复活；关闭时伙伴免疫所有伤害。
				}

				CompanionsRescueWhenOwnerHurt: {
					Label: "[i:MagicMirror] 受伤时紧急召回伙伴"
					Tooltip: 默认关闭。开启后，受伤会将伙伴传送到你周围彼此分开、避开实体方块、危险地块和附近威胁的位置；找不到安全落点时，伙伴会留在原地。
				}

				ExtraAccessorySlots: {
					Label: "[i:CelestialShell] 额外伙伴饰品栏"
					Tooltip: 客户端滑块，范围为 0 到 7。保存后会启用对应数量的伙伴专属额外饰品栏；调低时其中的物品会保留，但暂不生效。
				}

				CompanionsAutoCollectWorldItems: {
					Label: "[i:TreasureMagnet] 伙伴自动拾取世界掉落物"
					Tooltip: 默认关闭。关闭时伙伴不会扫描、预约、靠近或拾取地面掉落物；确认存档和其他模组兼容后再手动开启。
				}

				CompanionsAllowBackpackWorldDrops: {
					Label: "[i:TrashCan] 允许伙伴将背包物品丢到世界中"
					Tooltip: 默认关闭。“全部丢出”会创建世界掉落物，并可能触发其他模组的物品钩子；确认存档稳定后再手动开启。
				}
			}
		}

		Items: {
			PhantomStaff: {
				DisplayName: 幻影法杖
				Tooltip:
					'''
					挥动法杖：在身边放出或收回此法杖绑定的伙伴
					右键：伙伴已放出时，直接打开其背包
					第一次进入你的背包时，会自动获得独立编号并绑定给你
					别人绑定的法杖暂时禁用；在背包中右键可转绑，伙伴数据不会重置
					法杖位于物品栏时，按“轮盘”键指挥最靠前且已放出伙伴
					每根法杖始终只对应一名伙伴；原有书本与界面全部保留可用
					'''
			}

			DamageTestDummy: {
				DisplayName: 小兔兔
				Tooltip:
					'''
					多么可爱的小兔兔
					想必它一定同意做我的武器测试伤害工具
					点击左键放置傀儡，点击右键清除傀儡
					'''
			}

			DevelopmentNotice: {
				DisplayName: 幻影伙伴开发说明
				Development: 本模组仍在持续开发中。
				SoloCreator: 目前由作者一人制作与维护。
				Updates: 我会持续更新、完善伙伴功能，并处理玩家遇到的各种问题。
				Compatibility: 后续会逐步为各大型模组的热门武器制作点对点兼容。
				Complexity: 外观相近的武器，底层代码机制可能完全不同；有些兼容需要更多时间才能安全完成，感谢理解与耐心等待。
				BetaControlsFirstLine: 当前为测试版，有六本书和一个幻影法杖加轮盘两种操控方式
				BetaControlsSecondLine: 挑选一种合适的使用即可，后续会进行简化和整理
				ConfigSuggestion: 【考虑去看看配置选项】
				Tooltip: 查看开发说明与配置选项。
			}

			CompanionDevelopmentBook: {
				DisplayName: 开发书
				Tooltip:
					'''
					点击左键进行一系列的调试
					调试将自动进行
					--开发者物品--
					'''
				Started: 开发调试已开始。
				Stopped: 开发调试已停止并清理。
				Completed: 开发调试已完成并清理。
				Failed: 开发调试中断，临时伙伴已清理。
				StepSummon: "[开发调试] 已召唤临时伙伴。"
				StepAttack: "[开发调试] 已切换：攻击模式。"
				StepEscort: "[开发调试] 已切换：护卫模式。"
				StepGarrison: "[开发调试] 已切换：镇守模式。"
				StepCatch: "[开发调试] 已切换：捕捉模式。"
				StepFishing: "[开发调试] 已切换：钓鱼模式。"
				StepMining: "[开发调试] 已切换：挖矿模式。"
				StepWaypoint: "[开发调试] 已下达路标。"
				StepBackpack: "[开发调试] 已注入背包物品。"
			}

			CompanionDebugger: {
				DisplayName: 调试书
				Tooltip:
					'''
					左键：在鼠标位置召唤伙伴；再次使用会召唤下一个已保存的伙伴
					所有伙伴将会绑定至玩家而不是世界，这需要消换召唤栏位
					右键：打开伙伴管理面板；可以删除一些伙伴，也可以全部一键解散
					点击屏幕最上方的伙伴面板：打开其装备与背包
					也可以前往配置选项，开启“右键幻影玩家打开其背包”来直接右键伙伴本身打开背包
					武器：可放入任意武器（含召唤武器）；按武器栏从左到右选择，远程武器无弹时会用默认弹药

					技术要点：
					伙伴是注册在玩家槽位上的真实玩家实体：武器动画、装备效果与移动物理均由原版处理
					伙伴会寻路跟随（跳跃、飞行、下平台），只有长时间距离过远才会传送
					快速双击右键会让伙伴瞬间传送到身边；若在配置中开启受伤紧急召回，受伤会让伙伴传送到周围的安全位置护驾；卡死时也会自动传送回来
					由于这涉及的技术相对抽象，因此目前仅支持单人模式
					一些比较复杂或高级的模组武器不一定支持，具体不支持列表我没法给出，只能慢慢尝试
					'''
				RescueShortcut: 双击【{0}】可以将所有伙伴快速呼唤至自己身边
				RescueDefaultKey: 鼠标右键
			}

			CompanionCommandBook: {
				DisplayName: 指挥书
				Tooltip:
					'''
					按住右键：在「进攻 / 防卫 / 镇守」三种战斗模式间循环切换，切换时头顶会提示当前模式。
					· 进攻：自由跟随并主动攻击、挖矿与采集。
					· 防卫：紧贴玩家护卫，不主动攻击敌人。
					· 镇守：在进入模式的位置立下标记，守在原地作战，被击退也会返回。
					以及另外三种非战斗模式：「钓鱼 / 捕捉 / 挖矿」
					左键：在鼠标位置立一个信号标，伙伴会前往该处并镇守；再次左键点击标记附近可取消。
					信号标最多存在 5 秒，未抵达会自动消失；抵达后伙伴会镇守此处，直到收到新指令或触发已开启的受伤紧急召回。
					无论哪种模式，攻击方式都相同，只是移动方式不同。

					技术要点：
					未来会加入尽可能多的战术形态，以适应不同需求
					但即便是现在在一些复杂的地形中，也有可能出现寻路失败的bug
					总而言之，多尝试，出问题了就重新刷新，有严重问题就来评论区反馈
					我相信一定有大量问题是我一个人没法测出来的
					'''
			}

			CompanionHunterBook: {
				DisplayName: 猎人书
				Tooltip:
					'''
					左键：开始或放弃当前「猎人试炼」。猎人会先在远处集结，再开始行动。
					右键：选择 1 至 3 名猎人以及试炼规则。
					· 生存：在不断复活的猎人追杀下坚持 180 秒。
					· 讨伐：击败指定数量的猎人；他们会重整后继续参战。
					· 突围：在 150 秒内抵达远处突破点；猎人会沿路线提前拦截且不会休整。
					仅开放于困难模式前击败任意 Boss 后至肉山前，以及困难模式开始至世纪之花前；击败肉山或世纪之花会结束当前游戏。
					猎人只使用当前阶段的预设套装，绝不参考你的防御力。猎人越多，单个猎人的数值越低。
					'''
			}

			CompanionBuilderBook: {
				DisplayName: 建造书
				Tooltip:
					'''
					按住右键：呼出战术轮盘。点击左键：开启或关闭当前所选战术。
					· 智能建造：当你沿一条线持续放置同一种方块时，伙伴会用自己或你背包里的同种方块，朝同一方向继续建造。
					· 防御建造：当附近有敌人时，伙伴会在你与最近的敌人之间竖起一小截方块柱进行阻挡。
					· 战斗平台：当你站在平台上、且面朝方向前方的平台中断时，伙伴会用水平平台把缺口补上——大约只补你前方六格，所以要继续往前走才会继续铺。伙伴不会自己跳下平台，被打下去时会传送回你身边。
					伙伴优先消耗已召唤伙伴背包内的非收藏材料，其次才消耗你的背包；材料耗尽时工程会安全暂停。
					伙伴绝不会挖除或替换方块。战斗、护驾、信号标与专职模式永远优先于施工。目前仅支持单人模式。
					'''
			}

			CompanionAutomationBook: {
				DisplayName: 自动书
				Tooltip:
					'''
					【仅供娱乐，功能仍在测试】
					左键：召唤唯一一名自动伙伴（已经存在时不会重置或替换）
					右键：打开它的背包
					它会尝试独立探索、收集、建造、战斗并推进世界；通关后会变成普通幻影伙伴
					目前可能卡住、误判或出现其他问题，建议先备份世界。仅限单人模式。
					'''
			}

			PlayerScaleBook: {
				DisplayName: 倍率书
				Tooltip:
					'''
					【仅供娱乐，切勿当真】
					点击右键呼出界面，选择一个倍率
					选择好之后，点击左键可以将玩家自身放大或缩小至该倍率
					随时都可以回到原先的倍率
					'''
			}
		}

		VanillaItemHints: {
			LifeCrystal: 【幻影伙伴】无需给伙伴使用，伙伴会直接同步玩家的血量
			ManaCrystal: 【幻影伙伴】无需给伙伴使用，伙伴会直接同步玩家的魔力值
		}


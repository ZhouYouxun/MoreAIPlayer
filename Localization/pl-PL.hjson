# Localization file. Keep this UTF-8 (no BOM).
# The filename is just the culture code (en-US), so NO prefix is applied — the
# full "Mods.MoreAIPlayer." path is written out inside. Do NOT rename this to
# "en-US_Mods.MoreAIPlayer.hjson", or the prefix gets doubled and nothing matches.

Mods: {
	MoreAIPlayer: {
		Fault: {
			SubsystemError: "[Widmowy Towarzysz] Podsystem {0} napotkał błąd wewnętrzny i został na razie pominięty. Gra działa dalej."
			CompanionDisabled: "[Widmowy Towarzysz] Towarzysz wielokrotnie powodował błędy i został bezpiecznie usunięty, aby chronić grę."
			HunterDisabled: "[Widmowy Towarzysz] Łowca wielokrotnie powodował błędy i został bezpiecznie usunięty, aby chronić grę."
			CircuitOpened: "[Widmowy Towarzysz] {0} napotkał błąd i został wstrzymany na tę sesję świata. Pozostałe systemy działają dalej."
			CircuitStillOpen: "[Widmowy Towarzysz] Ryzykowna operacja pozostaje wstrzymana po błędzie. Wczytaj świat ponownie przed kolejną próbą."
			BackpackDropBlocked: "[Widmowy Towarzysz] Opróżnij plecak jest domyślnie wyłączone, aby chronić zapis. Włącz je w ustawieniach dopiero po sprawdzeniu zgodności."
		}

		Configs: {
			MoreAIPlayerClientConfig: {
				DisplayName: Ustawienia klienta Widmowych Towarzyszy

				Headers: {
					CompanionDiagnostics: Diagnostyka towarzyszy
					CompanionBalance: Balans i przetrwanie towarzyszy
					CompanionPickup: Zbieranie przedmiotów świata przez towarzyszy
					CompanionSafety: Bezpieczeństwo towarzyszy
				}

				EnablePhantomPlayerDebugText: {
					Label: "[i:GoldenKey] Włącz tekst diagnostyczny widmowych graczy"
					Tooltip: Wyświetla nad widmowymi towarzyszami bieżące informacje diagnostyczne. Domyślnie wyłączone.
				}

				ShowCompanionHealthBars: {
					// Label: "[i:LifeCrystal] Show companion health bars"
					// Tooltip: Disabled by default. Companions occupy real player slots, so the game already draws a health bar over them. Enable to also show the mod's own bar below each companion.
				}

				AllowRightClickOpenBackpack: {
					// Label: "[i:Chest] Right-click a companion to open its backpack"
					// Tooltip: Disabled by default. When off, right-clicking a companion does nothing and the backpack opens only through the matrix panel at the top of the screen. Enable to open it by right-clicking the companion.
				}

				CompanionsFightAfterOwnerDeath: {
					Label: "[i:EnchantedSword] Towarzysze walczą po śmierci gracza"
					Tooltip: Domyślnie włączone. Gdy zginiesz podczas walki z bossem, związani towarzysze zostają i walczą dalej. Wyłącz, aby natychmiast ich rozproszyć po śmierci.
				}

				CompanionsTakeDamage: {
					Label: "[i:CobaltShield] Towarzysze otrzymują obrażenia"
					Tooltip: Domyślnie włączone. Towarzysze otrzymują obrażenia, mogą zginąć i odradzają się po zwykłym czasie oczekiwania. Wyłącz, aby uodpornić ich na wszystkie obrażenia.
				}

				CompanionsAutoCollectWorldItems: {
					Label: "[i:TreasureMagnet] Towarzysze automatycznie zbierają przedmioty świata"
					Tooltip: Domyślnie wyłączone. Gdy opcja jest wyłączona, towarzysze nie skanują, nie rezerwują, nie podchodzą ani nie zbierają przedmiotów świata. Włącz ją dopiero po sprawdzeniu zgodności z zapisem i innymi modami.
				}

				CompanionsAllowBackpackWorldDrops: {
					Label: "[i:TrashCan] Pozwól towarzyszom wyrzucać przedmioty z plecaka do świata"
					Tooltip: Domyślnie wyłączone. Opróżnij plecak tworzy przedmioty świata i może wywołać hooki innych modów. Włącz dopiero po potwierdzeniu stabilności zapisu.
				}
			}
		}


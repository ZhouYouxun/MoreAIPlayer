# Localization file. Keep this UTF-8 (no BOM).
# The filename is just the culture code (en-US), so NO prefix is applied — the
# full "Mods.MoreAIPlayer." path is written out inside. Do NOT rename this to
# "en-US_Mods.MoreAIPlayer.hjson", or the prefix gets doubled and nothing matches.

Mods: {
	MoreAIPlayer: {
		Keybinds: {
			// CompanionWheel.DisplayName: Command Wheel
			CompanionRescue.DisplayName: Awaryjne przywołanie towarzyszy
		}

		Fault: {
			SubsystemError: "[Widmowy Towarzysz] Podsystem {0} napotkał błąd wewnętrzny i został na razie pominięty. Gra działa dalej."
			CompanionDisabled: "[Widmowy Towarzysz] Towarzysz wielokrotnie powodował błędy i został bezpiecznie usunięty, aby chronić grę."
			HunterDisabled: "[Widmowy Towarzysz] Łowca wielokrotnie powodował błędy i został bezpiecznie usunięty, aby chronić grę."
			CircuitOpened: "[Widmowy Towarzysz] {0} napotkał błąd i został wstrzymany na tę sesję świata. Pozostałe systemy działają dalej."
			CircuitStillOpen: "[Widmowy Towarzysz] Ryzykowna operacja pozostaje wstrzymana po błędzie. Wczytaj świat ponownie przed kolejną próbą."
			BackpackDropBlocked: "[Widmowy Towarzysz] Opróżnij plecak jest domyślnie wyłączone, aby chronić zapis. Włącz je w ustawieniach dopiero po sprawdzeniu zgodności."
			// BackpackRecovered: "[Phantom Companion] A companion data error was found at {0}. The affected state was cleaned and refreshed automatically."
			// BackpackRecoveryFailed: "[Phantom Companion] A companion error at {0} could not be refreshed safely, so the affected panel was closed. Details were written to the log."
		}

		Configs: {
			MoreAIPlayerServerConfig: {
				DisplayName: Zasady rozgrywki Widmowych Towarzyszy

				OrdinaryCompanionsHostileToPlayers: {
					Label: "[i:BloodyMachete] Zwykli towarzysze mogą ranić graczy"
					Tooltip: Towarzysze każdego gracza mogą przypadkowo zranić każdego gracza, niezależnie od włączenia PvP.
				}
			}

			MoreAIPlayerClientConfig: {
				DisplayName: Ustawienia klienta Widmowych Towarzyszy

				Headers: {
					CompanionDiagnostics: Diagnostyka towarzyszy
					CompanionBalance: Balans i przetrwanie towarzyszy
					CompanionPickup: Zbieranie przedmiotów świata przez towarzyszy
					CompanionSafety: Bezpieczeństwo towarzyszy
				}

				EnablePhantomPlayerDebugText: {
					Label: "[i:GoldenKey] Pokaż odczyty debugowania"
					Tooltip: Wyświetla odczyty debugowania deweloperskiego.
				}

				ShowAutomationProgress: {
					Label: "[i:Radar] Pokaż postęp automatycznego gracza"
					Tooltip: Pokazuje na czacie każdy istotny krok wykonany przez automatycznego gracza.
				}

				ShowCompanionHealthBars: {
					Label: "[i:LifeCrystal] Pokaż dodatkowy pasek zdrowia towarzysza"
					Tooltip: Rysuje własny pasek zdrowia tego moda. Włącz tylko, gdy domyślny pasek zdrowia nie działa.
				}

				UseChatForCompanionReviveTimer: {
					Label: "[i:RecallPotion] Powiadomienia czatu o śmierci i odrodzeniu"
					Tooltip: Wysyła powiadomienie, gdy towarzysz ginie lub odradza się.
				}

				AllowRightClickOpenBackpack: {
					Label: "[i:Chest] Kliknij towarzysza prawym, aby otworzyć plecak"
					Tooltip: Kolejny sposób na otwarcie plecaka; działa jak bezpośrednie kliknięcie jego karty.
				}

				CompanionsFightAfterOwnerDeath: {
					Label: "[i:EnchantedSword] Towarzysze walczą po śmierci gracza"
					Tooltip: Gdy wyłączone, towarzysze znikają natychmiast po twojej śmierci.
				}

				CompanionsTakeDamage: {
					Label: "[i:CobaltShield] Towarzysze otrzymują obrażenia"
					Tooltip: Pozwala towarzyszom otrzymywać normalne obrażenia, ginąć i czekać na odrodzenie.
				}

				CompanionsRescueWhenOwnerHurt: {
					Label: "[i:MagicMirror] Przywołaj towarzyszy po otrzymaniu obrażeń"
					Tooltip: Po otrzymaniu obrażeń natychmiast teleportuje wszystkich towarzyszy do ciebie.
				}

				ProtectBaseFromCompanionMining: {
					Label: "[i:PeaceCandle] Ochrona bazy"
					Tooltip: Gdy włączona, towarzysze nie uznają bloków w promieniu 200 pól od punktu odrodzenia świata za zniszczalne.
				}

				ExtraAccessorySlots: {
					Label: "[i:CelestialShell] Dodatkowe sloty akcesoriów"
					Tooltip: Pozwala towarzyszom zakładać więcej akcesoriów.
				}

				CompanionsAutoCollectWorldItems: {
					Label: "[i:TreasureMagnet] Automatycznie zbieraj przedmioty świata"
					Tooltip: Określa, czy towarzysze mogą próbować podnosić dowolne przedmioty świata.
				}

				CompanionsAllowBackpackWorldDrops: {
					Label: "[i:TrashCan] Zezwalaj na szybkie opróżnianie"
					Tooltip: Określa, czy plecak towarzysza jest opróżniany jedną czynnością. Może powodować spadki płynności.
				}
			}
		}


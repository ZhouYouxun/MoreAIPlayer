# Localization file. Keep this UTF-8 (no BOM).
# The filename is just the culture code (en-US), so NO prefix is applied — the
# full "Mods.MoreAIPlayer." path is written out inside. Do NOT rename this to
# "en-US_Mods.MoreAIPlayer.hjson", or the prefix gets doubled and nothing matches.

Mods: {
	MoreAIPlayer: {
		Configs: {
			MoreAIPlayerClientConfig: {
				// DisplayName: Phantom Companion Client Settings
				// Headers.CompanionDiagnostics: Companion Diagnostics

				EnablePhantomPlayerDebugText: {
					// Label: "[i:GoldenKey] Enable Phantom Player Debug Text"
					// Tooltip: Shows the live development readout above phantom companions. Disabled by default.
				}
			}
		}

		Items: {
			DamageTestDummy: {
				DisplayName: Króliczek
				Tooltip:
					'''
					Jaki uroczy króliczek.
					Na pewno zgodzi się zostać narzędziem do testowania obrażeń mojej broni.
					Lewy klik: postaw manekina. Prawy klik: usuń manekiny.
					'''
			}

			DevelopmentNotice: {
				// DisplayName: Phantom Companion Development Notice
				// Development: This mod is actively under development.
				// SoloCreator: It is made and maintained by one creator.
				// Updates: I will keep updating it, improving companions, and fixing problems reported by players.
				// Compatibility: Popular weapons from large mods will receive one-to-one compatibility work over time.
				// Complexity: Similar-looking weapons can use very different code internally; some therefore need much more time to support safely. Thank you for your patience.
				// Tooltip: ""
			}

			CompanionDebugger: {
				DisplayName: Księga debugowania
				Tooltip:
					'''
					Lewy przycisk myszy: przywołuje towarzysza w miejscu kursora. Użyj ponownie, aby przywołać kolejnego zapisanego towarzysza.
					Towarzysze są przypisani do gracza, a nie świata, i każdy zużywa miejsce sługi.
					Prawy przycisk myszy: otwiera menedżer towarzyszy. Możesz tam odesłać wybranych albo wszystkich naraz.
					Prawy klik na towarzyszu: otwiera jego wyposażenie i plecak. Nie musisz trzymać żadnego przedmiotu.
					Broń: można użyć każdej broni, także przywołującej. Pasek broni jest sprawdzany od lewej do prawej; bronie dystansowe używają podstawowej amunicji, gdy jej zabraknie.

					Uwagi techniczne:
					Towarzysze są prawdziwymi bytami gracza umieszczonymi w slotach graczy: animacje broni, efekty wyposażenia i fizyka ruchu są obsługiwane przez podstawową grę.
					Podążają za tobą dzięki wyszukiwaniu ścieżki, skacząc, latając i schodząc przez platformy; teleportują się dopiero po dłuższym przebywaniu daleko.
					Otrzymaj cios albo szybko kliknij dwukrotnie prawym przyciskiem, aby sprowadzić towarzyszy do ochrony; wrócą też automatycznie, gdy utkną.
					Ponieważ ten system jest dość nietypowy, na razie działa tylko w trybie jednoosobowym.
					Niektóre złożone lub zaawansowane bronie z innych modów mogą być niezgodne. Nie ma pełnej listy — testuj je stopniowo.
					'''
			}

			CompanionCommandBook: {
				DisplayName: Księga rozkazów
				Tooltip:
					'''
					Przytrzymaj prawy przycisk myszy: przełącza między trzema trybami walki Szturm / Obrona / Garnizon. Wybrany tryb pojawia się nad twoją głową.
					· Szturm: swobodnie podąża i aktywnie walczy, kopie oraz zbiera.
					· Obrona: trzyma się blisko jako ochroniarz i nie atakuje wrogów z własnej inicjatywy.
					· Garnizon: oznacza miejsce po wejściu w tryb, walczy tam i wraca po odrzuceniu.
					Są też trzy tryby niebojowe: Wędkarstwo / Łapanie / Górnictwo.
					Lewy przycisk myszy: umieszcza punkt trasy przy kursorze. Towarzysze pójdą tam i utrzymają pozycję; kliknij ponownie blisko znacznika, aby go anulować.
					Punkt trasy istnieje najwyżej 5 s i znika, jeśli nie zostanie osiągnięty. Po dotarciu towarzysz zostaje tam aż do nowego rozkazu lub wezwania pomocy.
					Zachowanie bojowe jest takie samo w każdym trybie — zmienia się tylko sposób poruszania.

					Uwagi techniczne:
					Z czasem zostanie dodanych jak najwięcej form taktycznych, aby spełnić różne potrzeby.
					Już teraz wyszukiwanie ścieżki może zawieść w złożonym terenie.
					Eksperymentuj śmiało. Jeśli coś pójdzie źle, odśwież i spróbuj ponownie; poważne problemy zgłaszaj w komentarzach.
					Z pewnością istnieje wiele problemów, których jedna osoba nie potrafi wykryć.
					'''
			}

			CompanionHunterBook: {
				DisplayName: Księga łowców
				Tooltip:
					'''
					Uwaga: ten przedmiot jest nadal testowany i może zawierać problemy.
					Lewy przycisk myszy: włącza lub wyłącza tryb Polowania. Wrodzy łowcy zaczną tropić cię po śladach.
					Prawy przycisk myszy: otwiera ustawienia Polowania i pozwala wybrać od 1 do 3 łowców.
					Wyposażenie łowców skaluje się z postępem świata i twoją obroną. Tryb Polowania włącza PvP, gdy jest aktywny.
					Łowcy ścigają cię przez 2 minuty, odpoczywają 45 sekund, a potem wznawiają pościg.
					Pokonani łowcy wracają po 60 sekundach z nowym wyposażeniem.
					'''
			}
		}

		CompanionCommand: {
			ModeAttack: Tryb szturmu
			ModeDefense: Tryb obrony
			ModeGarrison: Tryb garnizonu
			Switched: Widmowy towarzysz: {0}
			NoCompanion: Nie masz przywołanych widmowych towarzyszy.
			SingleplayerOnly: Widmowi towarzysze są na razie dostępni tylko w trybie jednoosobowym.
			Reviving: "{0} wraca za {1}s"
			NoFreeSlot: Brak wolnego slotu gracza dla widmowego towarzysza.
			MinionSlotsFull: Za mało miejsc na sługi, aby przywołać widmowego towarzysza.
			HunterModeEnabled: "[Tryb Polowania] włączony! Wrodzy łowcy tropią cię po śladach..."
			HunterModeDisabled: "[Tryb Polowania] wyłączony. Alarm odwołany."
			HunterSpawned: "[Ostrzeżenie] Wrogi gracz {0} zakradł się do twojego świata!"
			HunterDefeated: "[Komunikat] Wrogi gracz {0} został pokonany! Wróci za 60 sekund z nowym wyposażeniem..."
			HunterRespawned: "[Ostrzeżenie] Wrogi gracz {0} wrócił i wznawia pościg!"
			HunterSingleplayerOnly: Tryb Polowania jest na razie dostępny tylko w trybie jednoosobowym.
			Diagnostics: Diagnostyka widma: {0}  Build {1}
			Enabled: Wł.
			Disabled: Wył.
			HunterResting: "[Alarm łowcy] {0} wycofuje się, by odpocząć i zebrać zapasy!"
			HunterHunting: "[Alarm łowcy] {0} znów odnalazł twój ślad i wznawia polowanie!"
			HunterPanelTitle: ⚔ Ustawienia trybu Polowania
			Close: Zamknij
			HunterPanelEnabled: "[Stan trybu] Włączony (kliknij, aby wyłączyć)"
			HunterPanelDisabled: "[Stan trybu] Wyłączony (kliknij, aby włączyć)"
			HunterCountTitle: Liczba łowców:
			HunterCount: "{0} łowca/ów"
			HunterStatusTitle: Status łowców:
			HunterInactive: · Tryb Polowania jest nieaktywny
			HunterPanelReviving: · {0}: odradza się (pozostało {1}s)
			HunterPanelResting: · {0}: odpoczywa i zbiera zapasy
			HunterPanelHunting: · {0}: zbliża się, by cię zabić!
			HunterRefresh: 🔄 Odtwórz i rozmieść oddział łowców
			HunterRefreshed: Oddział łowców został odtworzony i rozmieszczony!
		}

		// NPCs.DamageTestDummyNPC.DisplayName: Damage Test Dummy N P C
	}
}

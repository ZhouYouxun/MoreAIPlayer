# Localization file. Keep this UTF-8 (no BOM).
# The filename is just the culture code (en-US), so NO prefix is applied — the
# full "Mods.MoreAIPlayer." path is written out inside. Do NOT rename this to
# "en-US_Mods.MoreAIPlayer.hjson", or the prefix gets doubled and nothing matches.

Mods: {
	MoreAIPlayer: {
		Keybinds: {
			// CompanionWheel.DisplayName: Command Wheel
			CompanionRescue.DisplayName: Llamada de emergencia de compañeros
		}

		Fault: {
			SubsystemError: "[Compañero Fantasma] El subsistema {0} sufrió un error interno y se omitió por ahora. El juego sigue funcionando."
			CompanionDisabled: "[Compañero Fantasma] Un compañero falló repetidamente y fue eliminado de forma segura para proteger el juego."
			HunterDisabled: "[Compañero Fantasma] Un cazador falló repetidamente y fue eliminado de forma segura para proteger el juego."
			CircuitOpened: "[Compañero Fantasma] {0} tuvo un error y se pausó durante esta sesión del mundo. Los demás sistemas siguen activos."
			CircuitStillOpen: "[Compañero Fantasma] Una operación de riesgo sigue pausada tras un error. Recarga el mundo antes de intentarlo de nuevo."
			BackpackDropBlocked: "[Compañero Fantasma] Vaciar mochila está desactivado por defecto para proteger tu partida. Actívalo en la configuración solo tras comprobar la compatibilidad."
			// BackpackRecovered: "[Phantom Companion] A companion data error was found at {0}. The affected state was cleaned and refreshed automatically."
			// BackpackRecoveryFailed: "[Phantom Companion] A companion error at {0} could not be refreshed safely, so the affected panel was closed. Details were written to the log."
		}

		Configs: {
			MoreAIPlayerServerConfig: {
				DisplayName: Reglas de juego de compañeros fantasma

				OrdinaryCompanionsHostileToPlayers: {
					Label: "[i:BloodyMachete] Los compañeros normales pueden herir a jugadores"
					Tooltip: Los compañeros de cualquier jugador pueden herir accidentalmente a cualquier jugador, con PvP activado o no.
				}
			}

			MoreAIPlayerClientConfig: {
				DisplayName: Configuración de cliente de Compañeros Fantasma

				Headers: {
					CompanionDiagnostics: Diagnóstico de compañeros
					CompanionBalance: Equilibrio y supervivencia de compañeros
					CompanionPickup: Recogida de objetos del mundo por compañeros
					CompanionSafety: Seguridad de compañeros
				}

				EnablePhantomPlayerDebugText: {
					Label: "[i:GoldenKey] Mostrar lecturas de depuración"
					Tooltip: Muestra lecturas de depuración de desarrollo.
				}

				ShowAutomationProgress: {
					Label: "[i:Radar] Mostrar progreso del jugador automático"
					Tooltip: Muestra en el chat cada paso significativo del jugador automático.
				}

				ShowCompanionHealthBars: {
					Label: "[i:LifeCrystal] Mostrar barra de vida extra del compañero"
					Tooltip: Dibuja la propia barra de vida de este mod. Actívala solo si la barra de vida predeterminada no funciona.
				}

				UseChatForCompanionReviveTimer: {
					Label: "[i:RecallPotion] Avisos de muerte y reanimación en el chat"
					Tooltip: Envía un aviso cuando un compañero muere o revive.
				}

				AllowRightClickOpenBackpack: {
					Label: "[i:Chest] Clic derecho al compañero para abrir mochila"
					Tooltip: Otra forma de abrir la mochila; equivale a hacer clic directamente en su pestaña.
				}

				CompanionsFightAfterOwnerDeath: {
					Label: "[i:EnchantedSword] Los compañeros luchan tras la muerte del jugador"
					Tooltip: Si se desactiva, los compañeros desaparecen inmediatamente al morir.
				}

				CompanionsTakeDamage: {
					Label: "[i:CobaltShield] Los compañeros reciben daño"
					Tooltip: Permite que los compañeros reciban daño normal, mueran y esperen para revivir.
				}

				CompanionsRescueWhenOwnerHurt: {
					Label: "[i:MagicMirror] Llamar compañeros al recibir daño"
					Tooltip: Al recibir daño, teletransporta de inmediato a todos los compañeros hacia ti.
				}

				ProtectBaseFromCompanionMining: {
					Label: "[i:PeaceCandle] Protección de la base"
					Tooltip: Al activarse, los compañeros no consideran rompibles los bloques dentro de 200 casillas del punto de aparición del mundo.
				}

				ExtraAccessorySlots: {
					Label: "[i:CelestialShell] Ranuras extra de accesorios"
					Tooltip: Permite que los compañeros equipen más accesorios.
				}

				CompanionsAutoCollectWorldItems: {
					Label: "[i:TreasureMagnet] Recoger automáticamente objetos del mundo"
					Tooltip: Determina si los compañeros pueden intentar recoger cualquier objeto del mundo.
				}

				CompanionsAllowBackpackWorldDrops: {
					Label: "[i:TrashCan] Permitir vaciado rápido"
					Tooltip: Determina si se vacía la mochila de un compañero con una sola acción. Puede causar retrasos.
				}
			}
		}

		Items: {
			PhantomStaff: {
				// DisplayName: Phantom Staff
				/* Tooltip:
					'''
					Swing the staff: summon or recall its bound companion near you
					Right click: open the bound companion's backpack while summoned
					The first time it enters your inventory, it receives your next number and binds to you
					A staff owned by someone else is disabled; right-click it in the inventory to transfer it without resetting the companion
					With this staff in your inventory, press the Command Wheel key to command the first summoned staff
					Each staff always corresponds to one companion. The original books remain fully usable.
					''' */
			}

			DamageTestDummy: {
				DisplayName: Conejito
				Tooltip:
					'''
					Qué conejito tan adorable.
					Seguro que acepta ser mi herramienta para probar el daño de armas.
					Clic izquierdo: colocar un muñeco. Clic derecho: eliminar muñecos.
					'''
			}

			DevelopmentNotice: {
				DisplayName: Nota de desarrollo de Compañeros Fantasma
				CombatControls: Clic izquierdo: blandir la llave | Clic derecho: lanzar la llave giratoria
				Development: Este mod sigue en desarrollo activo.
				SoloCreator: Está creado y mantenido por una sola persona.
				Updates: Seguiré actualizándolo, mejorando los compañeros y corrigiendo los problemas informados por los jugadores.
				Compatibility: Las armas populares de mods grandes recibirán compatibilidad individual con el tiempo.
				Complexity: Las armas de aspecto similar pueden usar mecanismos internos muy distintos; por eso algunas necesitan más tiempo para ser compatibles de forma segura. Gracias por tu paciencia.
				BetaControlsFirstLine: Esta beta tiene actualmente dos métodos de control: seis libros o el Bastón Fantasma con su rueda de comandos.
				BetaControlsSecondLine: Elige el que mejor te venga; los controles se simplificarán y reorganizarán más adelante.
				ConfigSuggestion: Considera revisar las opciones de configuración.
				Tooltip: Información sobre el desarrollo y las opciones de configuración.
			}

			CompanionDevelopmentBook: {
				DisplayName: Libro de desarrollo
				Tooltip:
					'''
					Haz clic izquierdo para ejecutar una serie de pruebas de depuracion.
					Las pruebas se ejecutaran automaticamente.
					-- Objeto de desarrollador --
					'''
				Started: Prueba de desarrollo iniciada.
				Stopped: Prueba de desarrollo detenida y limpiada.
				Completed: Prueba de desarrollo completada y limpiada.
				Failed: Prueba de desarrollo interrumpida; el companero temporal fue limpiado.
				StepSummon: "[DEV] Companero temporal invocado."
				StepAttack: "[DEV] Cambiado al modo de ataque."
				StepEscort: "[DEV] Cambiado al modo de escolta."
				StepGarrison: "[DEV] Cambiado al modo de guarnicion."
				StepCatch: "[DEV] Cambiado al modo de captura."
				StepFishing: "[DEV] Cambiado al modo de pesca."
				StepMining: "[DEV] Cambiado al modo de mineria."
				StepWaypoint: "[DEV] Punto de ruta asignado."
				StepBackpack: "[DEV] Objeto de mochila insertado."
			}

			CompanionDebugger: {
				DisplayName: Libro de depuración
				Tooltip:
					'''
					Clic izquierdo: invoca a un compañero en el cursor. Úsalo otra vez para invocar al siguiente compañero guardado.
					Los compañeros se vinculan al jugador, no al mundo, y cada uno consume un espacio de esbirro.
					Clic derecho: abre el gestor de compañeros. Desde ahí puedes despedir a algunos o a todos de una vez.
					Haz clic en el panel de compañeros de la parte superior de la pantalla: abre su equipo y mochila.
					También puedes activar «Clic derecho en un compañero para abrir su mochila» en Configuración para abrirla directamente con clic derecho sobre el compañero.
					Armas: admite cualquier arma, incluso de invocación. La barra de armas se revisa de izquierda a derecha; las armas a distancia usan munición básica cuando se quedan sin ella.

					Notas técnicas:
					Los compañeros son entidades de jugador reales registradas en huecos de jugador: las animaciones, efectos de equipo y física de movimiento los procesa el juego base.
					Te siguen mediante búsqueda de ruta, saltando, volando y bajando por plataformas; solo se teletransportan tras permanecer muy lejos durante un tiempo.
					Si recibes daño o haces doble clic derecho rápido, los compañeros acuden a protegerte; también regresan solos si se atascan.
					Como este sistema es bastante inusual, por ahora solo funciona en un jugador.
					Algunas armas complejas o avanzadas de otros mods podrían no ser compatibles. No hay una lista completa; pruébalas poco a poco.
					'''
				RescueShortcut: Haz doble clic en [{0}] para llamar rápidamente a todos los compañeros a tu lado.
				RescueDefaultKey: Botón derecho del ratón
			}

			CompanionCommandBook: {
				DisplayName: Libro de órdenes
				Tooltip:
					'''
					Mantén clic derecho: alterna entre los tres modos de combate Asalto / Defensa / Guarnición. El modo elegido aparece sobre tu cabeza.
					· Asalto: sigue libremente y ataca, mina y recoge de forma activa.
					· Defensa: permanece cerca como guardaespaldas y no ataca enemigos por iniciativa propia.
					· Guarnición: marca el lugar al entrar en el modo, combate allí y vuelve si lo apartan.
					También hay tres modos no combativos: Pesca / Captura / Minería.
					Clic izquierdo: deja un punto de ruta en el cursor. Los compañeros irán allí y mantendrán la posición; vuelve a hacer clic cerca de la marca para cancelarla.
					Un punto de ruta dura como máximo 5 s y desaparece si no se alcanza. Al llegar, el compañero se queda allí hasta recibir una orden nueva o una llamada de rescate.
					El comportamiento de ataque es igual en todos los modos; solo cambia la forma de moverse.

					Notas técnicas:
					Con el tiempo se añadirán tantas formas tácticas como sea posible para cubrir distintas necesidades.
					Incluso ahora, la búsqueda de ruta puede fallar en terrenos complejos.
					Experimenta todo lo que quieras. Si algo sale mal, actualiza y vuelve a intentarlo; si es grave, repórtalo en los comentarios.
					Seguro que hay muchos problemas que una sola persona no puede descubrir.
					'''
			}

			CompanionHunterBook: {
				DisplayName: Libro de cazadores
				Tooltip:
					'''
					Clic izquierdo: inicia o abandona la Prueba de cazadores elegida. Primero se reúnen a lo lejos.
					Clic derecho: elige de 1 a 3 cazadores y una regla.
					· Supervivencia: resiste 180 segundos contra cazadores que regresan al caer.
					· Eliminación: derrota la cantidad exigida de cazadores.
					· Ruptura: alcanza una salida lejana en 150 segundos; los cazadores interceptan tu ruta.
					Disponible tras cualquier jefe previo al Modo difícil hasta el Muro de Carne, y en el Modo difícil inicial hasta Plantera.
					Los equipos dependen de la fase del mundo, no de tu defensa. Más cazadores significa individuos más débiles.
					'''
			}

			CompanionBuilderBook: {
				DisplayName: Tomo del Arquitecto
				Tooltip:
					'''
					Hold right click: open the tactic wheel. Left click: switch the selected tactic on or off.
					· Smart Build: while you place the same block along a line, companions continue that block in the same direction from their own or your inventory.
					· Defensive Build: when an enemy is near, companions raise a short blocking pillar between you and the nearest threat.
					· Battle Platform: while you stand on a platform whose facing edge breaks off ahead, companions extend flat platforms across the gap — about six tiles ahead, so keep walking to keep bridging. They will not drop off the bridge, and return to your side if knocked off.
					Builders take non-favourited materials from active companion backpacks first, then your inventory. Work pauses safely if supplies run out.
					Companions never mine or replace blocks. Combat, rescue calls, waypoints and specialist modes always take priority. Single-player only.
					'''
			}

			CompanionAutomationBook: {
				DisplayName: Tomo automático
				Tooltip:
					'''
					[Solo para entretenimiento; esta función aún está en pruebas]
					Clic izquierdo: invoca al compañero automático; otro clic izquierdo lo retira y guarda su posición, inventario y memoria de progreso
					Clic derecho: mueve la cámara al compañero automático; otro clic derecho vuelve a ti
					Intentará explorar, reunir, construir, luchar y avanzar por el mundo de forma independiente; al terminar guardará la partida y se detendrá sin unirse al sistema de seguimiento de compañeros normales
					[c/FF4040:Advertencia: el compañero automático no sigue tus órdenes. Toma sus propias decisiones y continúa el proceso; puedes retirarlo con clic izquierdo para pausarlo, pero no cambiar sus decisiones.]
					Todavía puede atascarse, equivocarse o sufrir otros errores. Haz una copia del mundo primero. Solo un jugador.
					'''
			}

			PlayerScaleBook: {
				DisplayName: Tomo de Matriz de Cristal
				Tooltip: "[Solo por diversión] Clic derecho: abre la matriz y elige escala. Clic izquierdo: cambia tu tamaño; vuelve a pulsar para regresar a 1×."
			}
		}


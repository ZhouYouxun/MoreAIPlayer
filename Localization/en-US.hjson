# Localization file. Keep this UTF-8 (no BOM).
# The filename is just the culture code (en-US), so NO prefix is applied — the
# full "Mods.MoreAIPlayer." path is written out inside. Do NOT rename this to
# "en-US_Mods.MoreAIPlayer.hjson", or the prefix gets doubled and nothing matches.

Mods: {
	MoreAIPlayer: {
		Keybinds: {
			CompanionWheel.DisplayName: Command Wheel
			CompanionRescue.DisplayName: Companion Emergency Recall
		}

		Fault: {
			SubsystemError: "[Phantom Companion] Subsystem {0} hit an internal error and was skipped for now. The game keeps running normally."
			CompanionDisabled: "[Phantom Companion] A companion kept faulting and was safely removed to protect the game."
			HunterDisabled: "[Phantom Companion] A hunter kept faulting and was safely removed to protect the game."
			CircuitOpened: "[Phantom Companion] {0} hit an error and has been paused for this world session. Other companion systems remain active."
			CircuitStillOpen: "[Phantom Companion] A risky companion operation remains paused after an error. Reload the world before trying it again."
			BackpackDropBlocked: "[Phantom Companion] Companion backpack Drop All is disabled by default to protect your save. Enable it in Config only after checking compatibility."
			BackpackRecovered: "[Phantom Companion] A companion data error was found at {0}. The affected state was cleaned and refreshed automatically."
			BackpackRecoveryFailed: "[Phantom Companion] A companion error at {0} could not be refreshed safely, so the affected panel was closed. Details were written to the log."
		}

		Configs: {
			MoreAIPlayerServerConfig: {
				DisplayName: Phantom Companion Gameplay Settings

				OrdinaryCompanionsHostileToPlayers: {
					Label: "[i:BloodyMachete] Ordinary companions can hurt players"
					Tooltip: Companions belonging to any player can accidentally hurt any player, whether PvP is enabled or not.
				}
			}

			MoreAIPlayerClientConfig: {
				DisplayName: Phantom Companion Client Settings

				Headers: {
					CompanionDiagnostics: Companion Diagnostics
					CompanionBalance: Companion Balance & Survival
					CompanionPickup: Companion World-Item Pickup
					CompanionSafety: Companion Safety
				}

				EnablePhantomPlayerDebugText: {
					Label: "[i:GoldenKey] Display companion debug text"
					Tooltip: Displays development debug readings.
				}

				ShowAutomationProgress: {
					Label: "[i:Radar] Show automation progress"
					Tooltip: When enabled, every meaningful step advanced by the automation companion is shown in chat.
				}

				ShowCompanionHealthBars: {
					Label: "[i:LifeCrystal] Display extra companion health bar"
					Tooltip: Draws this mod's own health bar. Enable only if the default health bar does not work.
				}

				UseChatForCompanionReviveTimer: {
					Label: "[i:RecallPotion] Companion revival chat notices"
					Tooltip: Sends a notice when a companion dies or revives.
				}

				AllowRightClickOpenBackpack: {
					Label: "[i:Chest] Right-click companion to open backpack"
					Tooltip: Another way to open the backpack; equivalent to clicking its tab directly.
				}

				CompanionsFightAfterOwnerDeath: {
					Label: "[i:EnchantedSword] Companions fight after owner death"
					Tooltip: When disabled, companions disappear immediately after you die.
				}

				CompanionsTakeDamage: {
					Label: "[i:CobaltShield] Companions take damage"
					Tooltip: Allows companions to take normal damage, die, and wait to revive.
				}

				CompanionsRescueWhenOwnerHurt: {
					Label: "[i:MagicMirror] Rescue companions when you are hurt"
					Tooltip: Immediately teleports all companions to you when you are hurt.
				}

				ProtectBaseFromCompanionMining: {
					Label: "[i:PeaceCandle] Base protection"
					Tooltip: When enabled, companions will not treat blocks within 200 tiles of the world spawn as breakable.
				}

				ExtraAccessorySlots: {
					Label: "[i:CelestialShell] Extra accessory slots"
					Tooltip: Allows companions to equip more accessories.
				}

				CompanionsAutoCollectWorldItems: {
					Label: "[i:TreasureMagnet] Auto-pick up world drops"
					Tooltip: Whether companions may attempt to pick up any world drops.
				}

				CompanionsAllowBackpackWorldDrops: {
					Label: "[i:TrashCan] Allow quick drop all"
					Tooltip: Whether to empty a companion backpack with one action. This may cause lag.
				}
			}
		}

		Items: {
			PhantomStaff: {
				DisplayName: Phantom Staff
				Tooltip:
					'''
					Swing the staff: summon or recall its bound companion near you
					Right click: open the bound companion's backpack while summoned
					The first time it enters your inventory, it receives your next number and binds to you
					A staff owned by someone else is disabled; right-click it in the inventory to transfer it without resetting the companion
					With this staff in your inventory, press the Command Wheel key to command the first summoned staff
					Each staff always corresponds to one companion. The original books remain fully usable.
					'''
			}

			DamageTestDummy: {
				DisplayName: Little Bunny
				Tooltip:
					'''
					Such a cute little bunny.
					Surely it agrees to be my weapon damage test tool.
					Left click to place a dummy. Right click to clear dummies.
					'''
			}

			DevelopmentNotice: {
				DisplayName: Phantom Companion Development Notice
				CombatControls: Left click: swing the key | Right click: throw the rapidly spinning key
				Development: This mod is actively under development.
				SoloCreator: It is made and maintained by one creator.
				Updates: I will keep updating it, improving companions, and fixing problems reported by players.
				Compatibility: Popular weapons from large mods will receive one-to-one compatibility work over time.
				Complexity: Similar-looking weapons can use very different code internally; some therefore need much more time to support safely. Thank you for your patience.
				BetaControlsFirstLine: This beta currently has two control methods: six books, or a Phantom Staff with its command wheel.
				BetaControlsSecondLine: Choose whichever suits you; the controls will be simplified and reorganized later.
				ConfigSuggestion: Consider checking the configuration options.
				Tooltip: Development status and configuration options.
			}

			CompanionDevelopmentBook: {
				DisplayName: Development Book
				Tooltip:
					'''
					Left click to run a series of debug tests.
					The tests run automatically.
					-- Developer Item --
					'''
				Started: Development test started.
				Stopped: Development test stopped and cleaned up.
				Completed: Development test completed and cleaned up.
				Failed: Development test stopped; the temporary companion was cleaned up.
				StepSummon: "[DEV] Temporary companion summoned."
				StepAttack: "[DEV] Switched to Attack mode."
				StepEscort: "[DEV] Switched to Escort mode."
				StepGarrison: "[DEV] Switched to Garrison mode."
				StepCatch: "[DEV] Switched to Catch mode."
				StepFishing: "[DEV] Switched to Fishing mode."
				StepMining: "[DEV] Switched to Mining mode."
				StepWaypoint: "[DEV] Waypoint issued."
				StepBackpack: "[DEV] Backpack item injected."
			}

			CompanionDebugger: {
				DisplayName: Debug Book
				Tooltip:
					'''
					Left click: summon a companion at the cursor. Use it again to summon the next saved companion.
					Companions are tied to the player, not the world, and each one uses a minion slot.
					Right click: open the companion manager. Dismiss individual companions there, or dismiss everyone at once.
					Click the companion panel at the top of the screen: open its equipment and backpack.
					You can also enable “Right-click a companion to open its backpack” in Config to open it by right-clicking the companion itself.
					Weapons: any weapon is allowed, including summon weapons. The weapon bar is checked from left to right; ranged weapons use default ammunition when empty.

					Technical notes:
					Companions are real player entities registered in player slots: weapon animations, equipment effects, and movement physics are handled by vanilla.
					They follow using pathfinding — jumping, flying, and dropping through platforms — and teleport only after staying far away for a while.
					Taking a hit or quickly double-right-clicking recalls companions to guard you; they also recall automatically if stuck.
					Because this system is fairly unconventional, it currently supports single-player only.
					Some complex or advanced mod weapons may not be compatible. There is no complete incompatibility list, so please try them gradually.
					'''
				RescueShortcut: Double-click [{0}] to quickly call all companions to your side.
				RescueDefaultKey: Right Mouse Button
			}

			CompanionCommandBook: {
				DisplayName: Command Book
				Tooltip:
					'''
					Hold right click: cycle through the three combat modes — Attack / Defense / Garrison. The selected mode appears above your head.
					· Attack: follow freely and actively fight, mine, and gather.
					· Defense: stay close as a bodyguard and do not proactively attack enemies.
					· Garrison: mark your position when entering the mode, fight there, and return if knocked away.
					There are also three non-combat modes: Fishing / Catching / Mining.
					Left click: place a waypoint at the cursor. Companions travel there and garrison it; left-click near the marker again to cancel it.
					A waypoint lasts at most 5 seconds and disappears if unreached. Once reached, companions stay there until a new order or a rescue call.
					Attack behavior is the same in every mode; only movement behavior differs.

					Technical notes:
					More tactical modes will be added over time to cover as many needs as possible.
					Even now, pathfinding can fail in complicated terrain.
					Experiment freely. If something goes wrong, refresh and try again; for serious issues, please report them in the comments.
					I am sure there are many problems one person cannot uncover alone.
					'''
			}

			CompanionHunterBook: {
				DisplayName: Hunter Book
				Tooltip:
					'''
					Left click: start or abandon the selected Hunter Trial. Hunters assemble far away before acting.
					Right click: choose 1 to 3 hunters and a trial rule.
					· Survival: endure 180 seconds against hunters who return after defeat.
					· Elimination: defeat the required number of hunters as they regroup and return.
					· Breakout: reach a distant exit within 150 seconds; hunters intercept your route without resting.
					Available after any pre-Hardmode boss until the Wall of Flesh, or from Hardmode until Plantera. Defeating the Wall of Flesh or Plantera ends the current game.
					Hunter kits are curated for the current stage only; they never scale from your defence. More hunters means weaker individuals.
					'''
			}

			CompanionBuilderBook: {
				DisplayName: Architect's Tome
				Tooltip:
					'''
					Hold right click: open the tactic wheel. Left click: switch the selected tactic on or off.
					· Smart Build: while you place the same block along a line, companions continue that block in the same direction from their own or your inventory.
					· Defensive Build: when an enemy is near, companions raise a short blocking pillar between you and the nearest threat.
					· Battle Platform: while you stand on a platform whose facing edge breaks off ahead, companions extend flat platforms across the gap — about six tiles ahead, so keep walking to keep bridging. They will not drop off the bridge, and return to your side if knocked off.
					Builders take non-favourited materials from active companion backpacks first, then your inventory. Work pauses safely if supplies run out.
					Companions never mine or replace blocks. Combat, rescue calls, waypoints and specialist modes always take priority. Single-player only.
					'''
			}

			CompanionAutomationBook: {
				DisplayName: Automation Tome
				Tooltip:
					'''
					[For entertainment only; this feature is still in testing]
					Left click: summon the automation companion; left-click again to recall it and save its position, inventory, and progression memory
					Right click: move the camera to the automation companion; right-click again to return to yourself
					It will try to explore, gather, build, fight, and progress the world independently; after finishing, it stops and keeps its save, never joining the ordinary companion follow system
					It may still get stuck, make mistakes, or encounter other bugs. Back up your world first. Single-player only.
					'''
			}

			PlayerScaleBook: {
				DisplayName: Crystal Matrix Tome
				Tooltip:
					'''
					[For fun only. Do not take this seriously.]
					Right-click to open the matrix and choose a scale.
					After choosing, left-click to enlarge or shrink your player to that scale.
					You can return to the original scale at any time.
					'''
			}
		}

